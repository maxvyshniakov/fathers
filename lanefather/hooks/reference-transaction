#!/usr/bin/env bash
# One writer for main and dev (audit 2026-10-21, barrier B2). In an agent session
# (CLAUDECODE=1, or any CODEX_* variable set), refuses a ref transaction that moves
# refs/heads/main or refs/heads/dev unless LANDING_TOKEN matches the token of the
# landing lock, $(git rev-parse --git-common-dir)/landing.lock, taken less than 2 h
# ago. lanefather land, promote and sync take the lock and set the token;
# the refusal names the lane command for each legal move (#666). It also refuses
# writing ORIG_HEAD while main or dev is checked out, the first ref a merge or pull
# writes, so a refused fast-forward leaves the worktree untouched.
# Fetches (refs/remotes/*), other branches, tags, no-op updates and pack-refs
# packing/pruning pass; so does everyone outside an agent session. The hook fails open:
# a lock it cannot parse passes with a warning. This is the canonical hook; project and
# repo-kit copies pin these bytes from a committed lanefather source. Historical test
# fixtures stay frozen.

# Fast path, builtins only: this runs for every ref transaction in every worktree.
[[ "$1" == prepared ]] || exit 0
[[ "${CLAUDECODE:-}" == 1 || -n "${!CODEX_@}" ]] || exit 0

protected=()
common=""
while read -r old new ref; do
  case "$ref" in
    refs/heads/[Mm][Aa][Ii][Nn] | refs/heads/[Dd][Ee][Vv])
      if [[ "$new" =~ ^0+$ ]]; then
        # pack-refs prunes a loose ref after packing it: old is non-zero, packed-refs is
        # unlocked and already records the exact same OID, and the loose file still holds old.
        # Real deletions (branch -D, update-ref -d) pass all-zero old, hold packed-refs.lock
        # while removing the entry, or have no matching packed-refs line.
        if [[ "$old" != "$new" && ! "$old" =~ ^0+$ ]]; then
          [[ -n "$common" ]] || common="$(git rev-parse --git-common-dir 2>/dev/null)"
          if [[ -n "$common" && ! -e "$common/packed-refs.lock" && -f "$common/$ref" ]]; then
            loose=""
            read -r loose <"$common/$ref" 2>/dev/null
            if [[ "$loose" == "$old" ]] && grep -qxF -- "$old $ref" "$common/packed-refs" 2>/dev/null; then
              continue
            fi
          fi
        fi
        protected+=("$ref")
      elif [[ "$old" == "$new" ]]; then
        continue
      else
        # pack-refs (and same-SHA update-ref without oldvalue) emits 000..000 -> <cur>;
        # allow when the exact ref already resolves to new, which never creates or moves it.
        cur="$(git show-ref --verify -s "$ref" 2>/dev/null)"
        [[ -n "$cur" && "$cur" == "$new" ]] && continue
        protected+=("$ref")
      fi
      ;;
    ORIG_HEAD)
      [[ "$old" == "$new" || "$new" =~ ^0+$ ]] && continue
      orig_head=1
      ;;
  esac
done
if [[ -n "${orig_head:-}" ]]; then
  case "$(git symbolic-ref -q HEAD 2>/dev/null)" in
    refs/heads/[Mm][Aa][Ii][Nn]) protected+=("ORIG_HEAD (a merge, pull or reset of main)") ;;
    refs/heads/[Dd][Ee][Vv]) protected+=("ORIG_HEAD (a merge, pull or reset of dev)") ;;
  esac
fi
[[ ${#protected[@]} -gt 0 ]] || exit 0

ttl=7200
if [[ "${CLAUDECODE:-}" == 1 ]]; then agent="CLAUDECODE=1"; else agent="${!CODEX_@}"; agent="${agent%% *} set"; fi

[[ -n "$common" ]] || common="$(git rev-parse --git-common-dir 2>/dev/null)" || {
  echo "reference-transaction: warning: cannot find the Git directory; not checking the landing lock" >&2
  exit 0
}
lock="$common/landing.lock"
status=""
if [[ ! -e "$lock" ]]; then
  status="No landing lock is held."
else
  token="" holder="" acquired=""
  while read -r key value; do
    case "$key" in
      token) token="$value" ;;
      holder) holder="$value" ;;
      acquired) acquired="$value" ;;
    esac
  done <"$lock" 2>/dev/null
  if [[ -z "$token" || ! "$acquired" =~ ^[0-9]+$ ]]; then
    echo "reference-transaction: warning: $lock is unreadable or malformed; letting ${protected[*]} through. Remove it if no landing is in progress." >&2
    exit 0
  fi
  now="$(date +%s 2>/dev/null)"
  if [[ ! "$now" =~ ^[0-9]+$ ]]; then
    echo "reference-transaction: warning: cannot read the clock; not checking the landing lock" >&2
    exit 0
  fi
  since="$(date -r "$acquired" '+%Y-%m-%d %H:%M' 2>/dev/null || date -d "@$acquired" '+%Y-%m-%d %H:%M' 2>/dev/null)"
  if ((now - 10#$acquired > ttl)); then
    status="The landing lock held by ${holder:-an unnamed holder} since ${since:-$acquired} expired after 2 h."
  elif [[ "${LANDING_TOKEN:-}" == "$token" ]]; then
    exit 0
  elif [[ -n "${LANDING_TOKEN:-}" ]]; then
    status="LANDING_TOKEN does not match the landing lock, held by ${holder:-an unnamed holder} since ${since:-$acquired}."
  else
    status="The landing lock is held by ${holder:-an unnamed holder} since ${since:-$acquired}."
  fi
fi

printf '%s\n' >&2 \
  "reference-transaction: refusing to update ${protected[*]} from an agent session ($agent)." \
  "main and dev have one writer. $status" \
  "Commit on a lane or integration branch and land it with lanefather land <id>. Move main" \
  "or dev only with lanefather, run in this repository; it takes the landing lock:" \
  "  lanefather promote <sha> [--ship]  publish <sha>: push it to dev (and main), then fast-forward" \
  "  lanefather sync                    catch local main and dev up with origin" \
  "  lanefather sync --drop-local       drop stale local commits; a backup/ branch keeps them"
exit 1
