#!/usr/bin/env python3
"""A stand-in for `slotfather procs --json` over the machine's real process table (fathers#158), for the test that
runs done while short-lived processes come and go: ps lists this user's processes, one `lsof -d cwd` reads their
working directories (a zombie has none and is left out), and a pid whose directory could not be read is re-checked with ps and dropped when it exited
(Slotfather's procs.recheck), else reported unknown with its command. `sweep --json` offers nothing to stop.

`--cwd` answers for the test's own processes only: FIXTURE_PROCS_ROOT names the test's pid, and the processes outside
its tree are the machine's, not the test's. They cannot be in the lane's fresh temporary worktree, and some of them
have a working directory nobody of their user can read: on a Linux runner systemd --user and (sd-pam) are not
dumpable, so /proc/PID/cwd answers EACCES, the real source reports them unknown and every unattended done refuses.
FIXTURE_PROCS_UNREADABLE (comma-separated pids) reads those pids as such a process, on every platform.

  procs --json [--cwd PATH | --pid PID]    the version-2 answer with `unknown`
  sweep --json ...                         {"v": 2, "items": []}
"""
import json
import os
import subprocess
import sys


def table():
    rows = {}
    out = subprocess.run(["ps", "-axo", "pid=,ppid=,uid=,stat=,lstart=,command="], capture_output=True, text=True,
                         check=True).stdout
    for line in out.splitlines():
        words = line.split()
        # A zombie has exited: it has no working directory and runs nothing.
        if len(words) < 9 or words[3].startswith("Z"):
            continue
        rows[int(words[0])] = {"pid": int(words[0]), "ppid": int(words[1]), "uid": int(words[2]),
                               "start": " ".join(words[4:9]), "cmd": " ".join(words[9:])}
    return rows


def cwds():
    found, pid = {}, None
    out = subprocess.run(["lsof", "-nP", "-w", "-a", "-u", str(os.geteuid()), "-d", "cwd", "-Fpn"],
                         capture_output=True, text=True).stdout
    for line in out.splitlines():
        if line.startswith("p"):
            pid = int(line[1:])
        elif line.startswith("n") and pid is not None:
            found[pid] = line[1:]
    return found


def alive(rows, pids):
    if not pids:
        return set()
    out = subprocess.run(["ps", "-o", "pid=,lstart=", "-p", ",".join(map(str, pids))], capture_output=True,
                         text=True).stdout
    live = set()
    for line in out.splitlines():
        words = line.split()
        if words and int(words[0]) in rows and " ".join(words[1:6]) == rows[int(words[0])]["start"]:
            live.add(int(words[0]))
    return live


def descendants(rows, root):
    """The pids of root and every process below it in the table."""
    children = {}
    for row in rows.values():
        children.setdefault(row["ppid"], []).append(row["pid"])
    found, todo = set(), [root]
    while todo:
        pid = todo.pop()
        if pid not in found:
            found.add(pid)
            todo.extend(children.get(pid, []))
    return found


def main(args):
    if args[:1] == ["sweep"]:
        print(json.dumps({"v": 2, "items": []}))
        return 0
    if args[:1] != ["procs"]:
        print("usage: procs-slotfather procs|sweep", file=sys.stderr)
        return 2
    rows = table()
    own = {os.getpid(), os.getppid()}
    if "--pid" in args:
        pid = int(args[args.index("--pid") + 1])
        print(json.dumps({"v": 2, "cwd_unknown": [], "lease_unknown": [], "unknown": [],
                          "processes": [rows[pid]] if pid in rows else []}))
        return 0
    selected, unknown = list(rows.values()), []
    if "--cwd" in args:
        root = os.path.realpath(args[args.index("--cwd") + 1])
        directories = cwds()
        for pid in filter(None, os.environ.get("FIXTURE_PROCS_UNREADABLE", "").split(",")):
            directories.pop(int(pid), None)
        tree = descendants(rows, int(os.environ["FIXTURE_PROCS_ROOT"]))
        mine = [p for p in rows.values() if p["uid"] == os.geteuid() and p["pid"] not in own and p["pid"] in tree]
        unknown = sorted(alive(rows, [p["pid"] for p in mine if p["pid"] not in directories]))
        selected = [dict(p, cwd=directories[p["pid"]]) for p in mine if p["pid"] in directories
                    and (directories[p["pid"]] == root or directories[p["pid"]].startswith(root + "/"))]
    print(json.dumps({"v": 2, "cwd_unknown": unknown, "lease_unknown": [], "processes": selected,
                      "unknown": [{"pid": n, "start": rows[n]["start"], "cmd": rows[n]["cmd"], "cwd_unknown": True,
                                   "lease_unknown": False} for n in unknown]}))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
