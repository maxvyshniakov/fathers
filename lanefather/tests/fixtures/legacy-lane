# The default lane cap comes from the machine (#572): a lane per CORES_PER_LANE cores and per LANE_MEMORY_GB of the
# memory left after MEMORY_RESERVE_GB for macOS and the owner's apps. 12 cores and 32 GB give 6.
CORES_PER_LANE = 2
LANE_MEMORY_GB = 4
MEMORY_RESERVE_GB = 8


def machine_cores() -> int:
    """The core count; STRAYLIGHT_LANE_CORES stands in for it in tests."""
    stub = os.environ.get("STRAYLIGHT_LANE_CORES")
    return int(stub) if stub and stub.isdigit() and int(stub) > 0 else os.cpu_count() or 1


def machine_memory_gb() -> float:
    """Physical memory in GB; STRAYLIGHT_LANE_MEMORY_GB stands in for it in tests. macOS keeps its free page count
    near zero (the page cache holds the rest), so the cap counts the physical memory less a reserve."""
    stub = os.environ.get("STRAYLIGHT_LANE_MEMORY_GB")
    if stub:
        with contextlib.suppress(ValueError):
            return float(stub)
    try:
        return os.sysconf("SC_PHYS_PAGES") * os.sysconf("SC_PAGE_SIZE") / 2**30
    except (OSError, ValueError):
        return 0.0


def derived_cap(cores: int, memory_gb: float) -> int:
    return max(1, min(cores // CORES_PER_LANE, int((memory_gb - MEMORY_RESERVE_GB) // LANE_MEMORY_GB)))


def lane_cap(value: str | None) -> tuple[int, str]:
    """The lane cap and where it comes from: STRAYLIGHT_LANE_CAP, which the owner may raise for a stretch and every
    start logs, else the machine's derived cap. A bad value warns and keeps the derived cap, so a typo does not stop
    every tools/lane and tools/idle-watchdog run (#454)."""
    cores, memory = machine_cores(), machine_memory_gb()
    derived = derived_cap(cores, memory)
    if value and value.strip().isdigit() and int(value) > 0:
        return int(value), f"STRAYLIGHT_LANE_CAP override; derived: {derived}"
    if value:
        print(f"lane: warning: STRAYLIGHT_LANE_CAP={value!r} is not a positive whole number; the cap is {derived}",
              file=sys.stderr)
    return derived, f"derived from {cores} cores and {memory:.0f} GB of memory"


MAX_LANES, CAP_SOURCE = lane_cap(os.environ.get("STRAYLIGHT_LANE_CAP"))
CAP_OVERRIDDEN = CAP_SOURCE.startswith("STRAYLIGHT_LANE_CAP")
# Lanes in these statuses count toward MAX_LANES and hold their claims; a landed lane holds neither.
OCCUPYING = ("planned", "active")
LANDED = ("landed", "released", "done")
GATE_WORKTREE = "batch-gate"
# The branches only promote moves; promote's review gate covers lanes that are not in dev yet (#570).
PROMOTED = ("dev", "main")
MIN_DISK_GB = 150
LOAD_FACTOR = 1.5
# Release notes merge by union (#404 git hooks); every lane may append to them, so they are never claimed.
UNCLAIMED = ("release-notes/",)
RELEASE_NOTES_MERGE = ("-c", "merge.release-notes.name=Union of release notes entries",
                       "-c", "merge.release-notes.driver=git merge-file --union --diff3 -q %A %O %B")
ID = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$")


class LaneError(Exception):
    pass


# State

def state_dir() -> Path:
    path = Path(os.path.expanduser(os.environ.get("STRAYLIGHT_LANE_STATE")
                                   or "~/.local/state/straylight-orchestration/lanes"))
    path.mkdir(parents=True, exist_ok=True)
    return path


def now() -> str:
    return datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def parse_time(text: str) -> datetime.datetime:
    return datetime.datetime.fromisoformat(text.replace("Z", "+00:00"))


def record_path(lane_id: str) -> Path:
    if not ID.match(lane_id):
        raise LaneError(f"lane id {lane_id!r}: use letters, digits, '_' or '-'")
    return state_dir() / f"{lane_id}.json"


def receipt_path(lane_id: str, kind: str = "receipt") -> Path:
    return state_dir() / f"{lane_id}.{kind}.json"


def read_json(path: Path) -> dict | None:
    try:
        return json.loads(path.read_text())
    except (OSError, ValueError):
        return None


def write_json(path: Path, data: dict) -> None:
    pending = path.with_name(path.name + ".pending")
    pending.write_text(json.dumps(data, indent=2) + "\n")
    pending.replace(path)


def load(lane_id: str) -> dict:
    record = read_json(record_path(lane_id))
    if record is None:
        raise LaneError(f"no lane {lane_id}; register it with tools/lane start")
    record.setdefault("worktree", None)
    return record


def save(record: dict) -> None:
    write_json(record_path(record["id"]), record)


def lanes() -> list[dict]:
    found = []
    for path in sorted(state_dir().glob("*.json")):
        if path.name.count(".") == 1:
            record = read_json(path)
            if record and "id" in record:
                # A record from before #577 may lack the key; a planned lane's is null until adopt.
                record.setdefault("worktree", None)
                found.append(record)
    return found


def occupying(records: list[dict] | None = None) -> list[dict]:
    """The lanes that count toward the cap and hold their claims."""
    return [r for r in (lanes() if records is None else records) if r["status"] in OCCUPYING]


def ledger(message: str) -> None:
    with open(state_dir() / "ledger.log", "a", encoding="utf-8") as handle:
        handle.write(f"{now()} {message}\n")


@contextlib.contextmanager
def locked(name: str, waiting: str | None = None):
    """Hold the named lock in the state directory; print `waiting` first when another process holds it."""
    with open(state_dir() / f".{name}.lock", "a") as handle:
        try:
            fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            if waiting:
                print(waiting, flush=True)
            fcntl.flock(handle, fcntl.LOCK_EX)
        yield


# Landing lock (B2): .githooks/reference-transaction lets an agent session move main or dev only with
# LANDING_TOKEN equal to the token in <git common dir>/landing.lock, taken less than LANDING_TTL ago.

LANDING_TTL = 2 * 3600


def read_landing(path: Path) -> dict | None:
    """The lock's fields, {} for a file the hook would not parse, None when there is none."""
    try:
        text = path.read_text()
    except FileNotFoundError:
        return None
    except OSError:
        return {}
    fields = dict(line.split(" ", 1) for line in text.splitlines() if " " in line)
    return fields if fields.get("token") and re.fullmatch(r"[0-9]+", fields.get("acquired", "")) else {}


def landing_stale(fields: dict) -> str | None:
    """Why a lock may be taken over: malformed, expired, or its holder process has exited."""
    if not fields:
        return "malformed"
    if time.time() - int(fields["acquired"]) > LANDING_TTL:
        return "expired"
    pid = fields.get("pid", "")
    if pid.isdigit() and fields.get("host") == os.uname().nodename:
        try:
            os.kill(int(pid), 0)
        except ProcessLookupError:
            return f"holder pid {pid} has exited"
        except PermissionError:
            pass
    return None


def landing_holder(fields: dict) -> str:
    since = time.strftime("%Y-%m-%d %H:%M", time.localtime(int(fields["acquired"])))
    return f"{fields.get('holder', 'an unnamed holder')} since {since}"


@contextlib.contextmanager
def landing(common: str, holder: str, wait: float):
    """Hold the landing lock and yield an environment whose LANDING_TOKEN passes the hook."""
    path = Path(common) / "landing.lock"
    token = secrets.token_hex(16)
    deadline = time.monotonic() + wait
    while True:
        with open(path.with_name("landing.lock.guard"), "a") as guard:
            fcntl.flock(guard, fcntl.LOCK_EX)
            current = read_landing(path)
            stale = landing_stale(current) if current is not None else None
            if current is None or stale:
                pending = path.with_name(f"landing.lock.{os.getpid()}")
                pending.write_text(f"token {token}\nholder {holder}\nacquired {int(time.time())}\n"
                                   f"pid {os.getpid()}\nhost {os.uname().nodename}\n")
                pending.replace(path)
                if stale:
                    ledger(f"landing lock taken over from {current.get('holder', '?')} ({stale}) by {holder}")
                break
        if time.monotonic() >= deadline:
            raise LaneError(f"the landing lock ({path}) is held by {landing_holder(current)}; it expires "
                            f"{LANDING_TTL // 3600} h after it was taken. Wait for that landing to finish")
        time.sleep(0.5)
    try:
        yield dict(os.environ, LANDING_TOKEN=token)
    finally:
        with open(path.with_name("landing.lock.guard"), "a") as guard:
            fcntl.flock(guard, fcntl.LOCK_EX)
            if (read_landing(path) or {}).get("token") == token:
                path.unlink()


# Git

def git(cwd, *args: str, check: bool = True) -> str:
    result = subprocess.run(["git", *args], cwd=cwd, capture_output=True, text=True)
    if check and result.returncode:
        raise LaneError(f"git {' '.join(args)} in {cwd}: {result.stderr.strip()}")
    return result.stdout.strip()


def git_ok(cwd, *args: str) -> bool:
    return subprocess.run(["git", *args], cwd=cwd, capture_output=True).returncode == 0


def common_dir(cwd) -> str:
    return os.path.realpath(git(cwd, "rev-parse", "--path-format=absolute", "--git-common-dir"))


def main_checkout(common: str) -> str:
    return os.path.dirname(common) if os.path.basename(common) == ".git" else common


def current_branch(worktree) -> str:
    return git(worktree, "symbolic-ref", "--quiet", "--short", "HEAD", check=False)


def worktree_list(cwd) -> list[dict]:
    entries, entry = [], {}
    for line in git(cwd, "worktree", "list", "--porcelain").splitlines() + [""]:
        if not line:
            if entry:
                entries.append(entry)
            entry = {}
        elif line.startswith("worktree "):
            entry["path"] = os.path.realpath(line[len("worktree "):])
        elif line.startswith("branch refs/heads/"):
            entry["branch"] = line[len("branch refs/heads/"):]
        elif line == "locked" or line.startswith("locked "):
            entry["locked"] = line[len("locked "):] or "no reason given"
    return entries


def worktree_lock(cwd, worktree: str) -> str | None:
    """The lock reason of a locked worktree (the Agent harness locks its worktrees while it runs), else None."""
    path = os.path.realpath(worktree)
    return next((w.get("locked") for w in worktree_list(cwd) if w["path"] == path), None)


def dirty(worktree) -> str:
    return git(worktree, "status", "--porcelain")


# Claims

def tokens(segment: str) -> tuple:
    result, index = [], 0
    while index < len(segment):
        char = segment[index]
        end = segment.find("]", index + 2) if char == "[" else -1
        if end > 0:
            result.append(segment[index:end + 1])
            index = end + 1
        else:
            result.append(char)
            index += 1
    return tuple(result)


def char_overlap(a: str, b: str) -> bool:
    if "?" in (a, b):
        return True
    candidates = [c for c in (a, b) if len(c) == 1] or [chr(code) for code in range(32, 127)]
    return any(fnmatch.fnmatchcase(c, a) and fnmatch.fnmatchcase(c, b) for c in candidates)


@functools.lru_cache(maxsize=None)
def segments_overlap(a: tuple, b: tuple) -> bool:
    if not a or not b:
        return all(t == "*" for t in a + b)
    if a[0] == "*" and (segments_overlap(a[1:], b) or segments_overlap(a, b[1:])):
        return True
    if b[0] == "*" and (segments_overlap(a, b[1:]) or segments_overlap(a[1:], b)):
        return True
    return "*" not in (a[0], b[0]) and char_overlap(a[0], b[0]) and segments_overlap(a[1:], b[1:])


def glob_segments(claim: str) -> tuple:
    parts = tuple(part for part in claim.strip("/").split("/") if part)
    return parts + ("**",) if not any(c in claim for c in "*?[") else parts


@functools.lru_cache(maxsize=None)
def paths_overlap(a: tuple, b: tuple) -> bool:
    if not a or not b:
        return all(part == "**" for part in a + b)
    if a[0] == "**" and (paths_overlap(a[1:], b) or paths_overlap(a, b[1:])):
        return True
    if b[0] == "**" and (paths_overlap(a, b[1:]) or paths_overlap(a[1:], b)):
        return True
    return ("**" not in (a[0], b[0]) and segments_overlap(tokens(a[0]), tokens(b[0]))
            and paths_overlap(a[1:], b[1:]))


def claims_overlap(a: str, b: str) -> bool:
    return paths_overlap(glob_segments(a), glob_segments(b))


def matches(claim: str, path: str) -> bool:
    """A changed path, whose segments carry no wildcards in practice, against a claim."""
    return paths_overlap(glob_segments(claim), tuple(path.split("/")))


# Rule snippets (tools/agent-hooks/rules/*.md): the brief lists those whose paths a claim touches.

RULES_DIR = Path("tools") / "agent-hooks" / "rules"


def read_rules(root) -> list[dict]:
    """Each snippet's name, title, path globs and body; a file without front matter paths is skipped."""
    rules = []
    for path in sorted((Path(root) / RULES_DIR).glob("*.md")):
        lines = path.read_text().splitlines()
        if not lines or lines[0].strip() != "---" or "---" not in (line.strip() for line in lines[1:]):
            continue
        end = next(i for i in range(1, len(lines)) if lines[i].strip() == "---")
        title, globs, key = path.stem, [], None
        for line in lines[1:end]:
            stripped = line.strip()
            if stripped.startswith("- ") and key == "paths":
                globs.append(stripped[2:].strip())
            elif ":" in stripped:
                key, _, value = (part.strip() for part in stripped.partition(":"))
                if key == "title" and value:
                    title = value
        body = "\n".join(lines[end + 1:]).strip()
        if globs and body:
            rules.append({"name": path.stem, "title": title, "paths": globs, "body": body})
    return rules


def rules_for(claims, root) -> list[dict]:
    """The snippets with a glob some claim overlaps, each with the globs that matched."""
    selected = []
    for rule in read_rules(root):
        hit = [glob for glob in rule["paths"] if any(claims_overlap(claim, glob) for claim in claims)]
        if hit:
            selected.append(dict(rule, matched=hit))
    return selected


def rules_block(rules: list[dict]) -> list[str]:
    if not rules:
        return [f"Rules for these claims: none ({RULES_DIR}/)"]
    lines = [f"Rules for these claims ({RULES_DIR}/):"]
    for rule in rules:
        lines.append(f"{rule['title']} ({', '.join(rule['matched'])}):")
        lines.extend("  " + line if line else "" for line in rule["body"].splitlines())
    return lines


# Host

def load15() -> float:
    """The 15-minute load average; STRAYLIGHT_LANE_LOAD15 stands in for it in tests."""
    stub = os.environ.get("STRAYLIGHT_LANE_LOAD15")
    return float(stub) if stub else os.getloadavg()[2]


def host() -> dict:
    disk = os.environ.get("STRAYLIGHT_LANE_DISK_FREE_GB")
    return {"disk_free_gb": float(disk) if disk else shutil.disk_usage(Path.home()).free / 1e9,
            "load15": load15(), "cores": machine_cores()}


def load_limit(cores: int) -> float:
    """The load15 at which tools/lane start refuses a lane and a verify run waits (#572)."""
    return LOAD_FACTOR * cores


def host_fields(info: dict) -> str:
    """The host snapshot in ledger lines, which tools/orchestration-metrics.py reads for disk and load peaks."""
    return f"disk_free_gb={info['disk_free_gb']:.0f} load15={info['load15']:.1f} cores={info['cores']}"


def host_line(info: dict) -> str:
    return (f"disk free {info['disk_free_gb']:.0f} GB (minimum {MIN_DISK_GB} GB); load15 {info['load15']:.1f} on "
            f"{info['cores']} cores (maximum {load_limit(info['cores']):.1f})")


SMOKE_MAX_JOBS = 3
FALLBACK_JOBS = 2


GATE_MAX_JOBS = 2
# A lane check's most jobs (#642 review). At one slot lane checks used 1.1-1.4 of its 2 cores (slotfather stats,
# 2026-11-03); a second slot lets the slot-sized checks (Cargo, the domain build) run side by side and the desktop
# tests take a second worker. Advice gives it only on a quiet machine: at 9 of 33 lane-check grants that day.
CHECK_MAX_JOBS = 2


def jobs_decision(info: dict, maximum: int, exclusive: bool = False) -> dict:
    """verify --jobs for a run, and why: `slotfather advise --max <maximum>` (#599, #619), which takes out the cores
    of load that no lease explains and, without --exclusive, the slots others hold. Without an answer (slotfather
    is not installed or failed), FALLBACK_JOBS, recording why. `info` is the host snapshot of the caller."""
    try:
        return heavy_module().advise(maximum, exclusive)
    except Exception as error:
        return {"jobs": min(FALLBACK_JOBS, maximum), "fallback": f"{type(error).__name__}: {error}"}


def post_merge_jobs(info: dict) -> dict:
    """The post-merge smoke runs beside the lanes' checks: at most 3 jobs and never more than the free slots, since
    the slot queue is FIFO and a bigger lease would wait for them."""
    return jobs_decision(info, SMOKE_MAX_JOBS)


def gate_jobs(info: dict) -> dict:
    """The batch gate is an ordinary full gate (#610): it shares the machine, at most two jobs and no more than the
    free slots; only the perf suite and a rerun alone hold every slot."""
    return jobs_decision(info, GATE_MAX_JOBS)


def check_jobs(info: dict) -> dict:
    """A lane check shares the machine like the batch gate: at most CHECK_MAX_JOBS and no more than the free slots,
    fewer under load that no lease explains or short memory."""
    return jobs_decision(info, CHECK_MAX_JOBS)


def given_jobs(jobs: int, option: str) -> dict:
    return {"jobs": jobs, "override": option}


# Suites and checks

def plan_for(root, base: str) -> dict:
    """The tree's own verification plan (tools/verification_plan.py through verify.sh --changed) since `base`.

    `selection` lists the checks it selects, [{id, suite, paths}] in plan order, each with the changed paths that
    chose it: every check of the gate for a full plan, and None for a tree whose plan names whole suites. `selected`
    names the suites those checks belong to in the tree's order, `by_suite` the checks of each."""
    result = subprocess.run([os.path.join(root, "verify.sh"), "--changed", "--base", base, "--plan", "--json"],
                            cwd=root, capture_output=True, text=True)
    if result.returncode:
        raise LaneError(f"verify.sh --changed --plan in {root} failed: {result.stderr.strip()}")
    plan = json.loads(result.stdout)
    rows = plan.get("checks")
    if rows is None:
        plan.update(selection=None, selected=list(plan["suites"]), by_suite=None)
        return plan
    # A full plan (a path no check reads, or a change that selects every check) runs every check of the gate; its
    # rows that no changed path chose run for the paths no check reads, or for every changed path. Since #638 a
    # runner change (verify.sh, tools/verify.py, ...) selects only its canary checks and a graph change the checks
    # it redefines: narrow plans like any other.
    full_why = plan.get("unowned") or plan["paths"]
    plan["selection"] = [{"id": row["id"], "suite": row["suite"],
                          "paths": row["paths"] or (full_why if plan.get("full") else [])}
                         for row in rows if plan.get("full") or not row["producer"]]
    plan["selected"] = suites_of(plan["selection"])
    plan["by_suite"] = by_suite(plan["selection"])
    return plan


def suites_of(rows: list[dict]) -> list[str]:
    """The suites of selected checks, in the order their first checks come."""
    return list(dict.fromkeys(row["suite"] for row in rows))


def by_suite(rows: list[dict] | None) -> dict[str, list[str]] | None:
    """The selected checks of each suite, in plan order; None for a selection of whole suites."""
    if rows is None:
        return None
    return {suite: [row["id"] for row in rows if row["suite"] == suite] for suite in suites_of(rows)}


def verification_plan(root):
    """The tree's own tools/verification_plan.py module; None for a tree without it."""
    try:
        path = Path(root) / "tools" / "verification_plan.py"
        loader = importlib.machinery.SourceFileLoader(f"lane_plan_{abs(hash(str(path)))}", str(path))
        spec = importlib.util.spec_from_loader(loader.name, loader)
        module = importlib.util.module_from_spec(spec)
        sys.path.insert(0, str(path.parent))
        try:
            loader.exec_module(module)
        finally:
            sys.path.remove(str(path.parent))
        return module
    except Exception:
        return None


def suite_owners(root, suites) -> dict[str, set[str]] | None:
    """Each suite's check ids, from the tree's own verification plan; None for a tree without it."""
    module = verification_plan(root)
    try:
        return {suite: {c.id for c in module.checks(Path(root), Path("/nonexistent"), {suite}, True, False, 1)}
                for suite in suites} if module else None
    except Exception:
        return None


def smoke_checks(root) -> list[str] | None:
    """The tree's post-merge smoke (tools/verification_plan.py smoke()), as check ids; None for a tree without it."""
    module = verification_plan(root)
    try:
        return list(module.smoke(Path(root))) if module and hasattr(module, "smoke") else None
    except Exception:
        return None


def post_merge_selection(root, plan: dict) -> tuple[str, list[dict] | None]:
    """What the post-merge check of a merge runs, given the merged diff's plan (plan_for since the previous tip):
    ("plan", its selection) when the diff selects only structure checks (documentation), otherwise ("smoke", the
    tree's smoke, #446). Each row is {id, suite, paths}: the merged paths that select the check, or [] for a smoke
    check the diff does not select, which runs because the smoke runs everything that builds. A tree without a smoke
    runs the plan."""
    selection = plan["selection"]
    if set(plan["selected"]) <= {"structure"}:
        return "plan", selection
    ids = smoke_checks(root)
    module = verification_plan(root)
    if not ids or module is None:
        return "plan", selection
    try:
        every = module.checks(Path(root), Path("/nonexistent"), set(module.SUITES), True, False, 4, bundle=False)
    except Exception:
        return "plan", selection
    suite = {check.id: check.suite for check in every}
    why = {row["id"]: row["paths"] for row in selection or ()}
    rows = [{"id": i, "suite": suite[i], "paths": why.get(i, [])} for i in ids if i in suite]
    # The smoke's checks in the tree's suite order.
    order = {s: n for n, s in enumerate(module.SUITES)}
    return "smoke", sorted(rows, key=lambda row: order.get(row["suite"], len(order)))


def lane_basis(receipt: dict | None, landed: dict, toolchain) -> str | None:
    """Why the lane's receipt cannot stand for part of its merge's smoke (#640), or None when it can: green, for
    the tree the lane landed, with per-check results, and run with the Rust the smoke resolves (#571)."""
    if not receipt:
        return "the lane has no receipt"
    if receipt.get("status") != "green":
        return "the lane's receipt is red"
    if receipt.get("tree") != landed["tree"]:
        return f"the lane's receipt covers tree {str(receipt.get('tree'))[:10]}, not the landed tree {landed['tree'][:10]}"
    if receipt.get("checks") is None or receipt.get("check_results") is None:
        return "the lane's receipt has no per-check results"
    if receipt.get("toolchain") != toolchain:
        return "the Rust toolchain changed since the lane check"
    return None


def narrow_smoke(checkout, receipt: dict | None, landed: dict, merge_tree: str, kind: str,
                 rows: list[dict] | None) -> tuple[str, list[dict] | None, dict]:
    """The part of the post-merge selection `rows` that the merge still needs after the lane's green receipt
    (#640): (kind, rows, narrowing).

    The receipt verified the lane's tree; the merge differs from it only by what the integration brought in, the
    diff from the lane tip to the merge. A check that diff does not select reads the same files on both trees, so
    the lane's passed result stands for it. What runs:
    - each check that diff selects, with the integration's paths that select it;
    - every other check the receipt does not show passed: a red check its classification let land, one it did not
      run, one its plan did not select (a build a lib-only lane never ran reads the lane base's files, which an
      earlier merge may have left red; review of #640, finding 1). Each carries `unverified`, the receipt's status.
    Nothing left is kind "skip", the receipt standing as the smoke's result, otherwise "narrowed"; `lane_verified`
    holds the receipt's result for each check left out. A diff that selects the full gate (a path no check reads)
    or a receipt that does not cover the landed tree (lane_basis) leaves the rows as they were, with the reason."""
    if rows is None:
        return kind, rows, {"narrowed": False, "reason": "the tree's plan names whole suites"}
    reason = lane_basis(receipt, landed, toolchain_state(checkout))
    if reason:
        return kind, rows, {"narrowed": False, "reason": reason}
    basis = {"receipt_tree": receipt["tree"], "receipt_head": receipt.get("head"), "lane_tip": landed["tip"]}
    if merge_tree == receipt["tree"]:
        brought, paths = {}, []
    else:
        delta = plan_for(checkout, landed["tip"])
        paths = delta["paths"]
        if delta.get("full") or delta["selection"] is None:
            return kind, rows, dict(basis, narrowed=False, integration_paths=paths,
                                    reason="what the integration brought in selects the full gate")
        brought = {row["id"]: row["paths"] for row in delta["selection"]}
    results = receipt["check_results"]
    passed = {c for c, e in results.items() if e.get("status") == "passed"}
    kept = []
    for row in rows:
        if row["id"] in brought:
            kept.append(dict(row, paths=brought[row["id"]]))
        elif row["id"] not in passed:
            kept.append(dict(row, unverified=(results.get(row["id"]) or {}).get("status", "not selected")))
    running = {row["id"] for row in kept}
    # Every check left out passed in the receipt; land records its result in check_results.
    lane_verified = {row["id"]: dict(results[row["id"]], reused_from=results[row["id"]].get("reused_from")
                                     or receipt["tree"]) for row in rows if row["id"] not in running}
    narrowing = dict(basis, narrowed=True, integration_paths=paths, lane_verified=lane_verified,
                     dropped=list(lane_verified))
    return ("narrowed" if kept else "skip"), kept, narrowing


def owned(owners, suite: str, check_id: str) -> bool:
    # A tree without the plan (fixtures, other repos) falls back to the suite's name as the id prefix.
    return check_id in owners[suite] if owners is not None else check_id.startswith(suite)


def suites_for_checks(root, check_ids, suites) -> list[str]:
    """The selected suites that own any of the failed checks."""
    owners = suite_owners(root, suites)
    return [s for s in suites if any(owned(owners, s, c) for c in check_ids)]


def triage(root, run: Path) -> str | None:
    """tools/gate-triage.py's classification of a red run's failures against the flake registry."""
    script = Path(root) / "tools" / "gate-triage.py"
    if not script.is_file():
        return None
    result = subprocess.run([sys.executable, str(script), str(run), "--root", str(root)], cwd=root,
                            capture_output=True, text=True)
    return (result.stdout + result.stderr).strip() or None


# verify.py report statuses that are not a failure.
PASSING = ("passed", "not_run", "skipped")
STAMPED = re.compile(r"^Verified tree ([0-9a-f]+) stamped\b", re.M)
NOT_STAMPED = re.compile(r"^Verified tree not stamped: (.+?)\.?$", re.M)


def stamp_result(text: str, full: bool) -> dict:
    """What verify.py's own verified-tree stamp (tools/verified-tree.sh finish) printed for this run."""
    if not full:
        return {"stamped": False, "reason": "selected suites; only the full plan stamps"}
    stamped = STAMPED.findall(text)
    if stamped:
        return {"stamped": True, "tree": stamped[-1]}
    reason = NOT_STAMPED.findall(text)
    return {"stamped": False, "reason": reason[-1] if reason else "the full run did not pass"}


DEFAULT_LOAD_WAIT = 3600.0
DEFAULT_LOAD_POLL = 30.0


def seconds_setting(name: str, default: float) -> float:
    try:
        value = float(os.environ.get(name) or default)
    except ValueError:
        return default
    return value if value > 0 else default


def load_averages() -> list[float]:
    """The 1, 5 and 15-minute load averages; the last is load15(), which tests stub."""
    one, five, _ = os.getloadavg()
    return [round(one, 2), round(five, 2), round(load15(), 2)]


def load_wait_enabled() -> bool:
    """Owner decision on the #572 review (2026-10-27): no load throttle by default; timing and performance tests move
    to a perf suite that only the batch gate runs. STRAYLIGHT_LOAD_WAIT=1 turns the wait on."""
    return os.environ.get("STRAYLIGHT_LOAD_WAIT") == "1"


def wait_for_load(label: str) -> dict:
    """With STRAYLIGHT_LOAD_WAIT=1, wait until load15 is at or below the limit tools/lane start enforces before a
    verify run starts (#572); the wait for the receipt, which says whether it was on. It runs before verify.sh asks
    for its slot lease, so it never holds a slot. A process that already runs under a lease (#568's rerun alone holds
    all four) does not wait: it would hold those slots idle. After STRAYLIGHT_LANE_LOAD_WAIT seconds (default 3600)
    the run starts anyway, marked gave_up."""
    limit = load_limit(machine_cores())
    before = load15()
    wait = {"enabled": load_wait_enabled(), "limit": limit, "load15_before": before, "load15": before, "seconds": 0.0}
    if before <= limit or not wait["enabled"]:
        return wait
    if os.environ.get("SLOTFATHER_LEASE"):
        return dict(wait, skipped="runs under a slot lease it holds; a wait would hold those slots idle")
    patience = seconds_setting("STRAYLIGHT_LANE_LOAD_WAIT", DEFAULT_LOAD_WAIT)
    poll = seconds_setting("STRAYLIGHT_LANE_LOAD_POLL", DEFAULT_LOAD_POLL)
    print(f"lane: load15 {before:.1f} is above the limit {limit:.1f} ({LOAD_FACTOR} x {machine_cores()} cores); "
          f"{label} waits for it to drop, at most {patience:.0f} s", flush=True)
    clock = time.monotonic()
    current = before
    while current > limit and time.monotonic() - clock < patience:
        time.sleep(max(0.0, min(poll, patience - (time.monotonic() - clock))))
        current = load15()
    wait.update(load15=current, seconds=round(time.monotonic() - clock, 1))
    if current > limit:
        wait["gave_up"] = True
    print(f"lane: {label} starts after {wait['seconds']:.0f} s at load15 {current:.1f}"
          + (" (still above the limit)" if current > limit else ""), flush=True)
    ledger(f"load-wait {label} seconds={wait['seconds']} load15={before}->{current} limit={limit}"
           + (" gave up" if current > limit else ""))
    return wait


def run_suites(root, suites: list[str], label: str, slots: int, full: bool = False,
               selected: dict[str, list[str]] | None = None, phase: str = "check",
               meta: dict | None = None) -> tuple[list[dict], dict[str, dict], str | None, dict]:
    """Each suite's result, each selected check's result, the gate triage when the run is red, and the verified-tree
    stamp.

    A full plan runs verify.sh without a selection: that is the full gate, which stamps the tree for
    pre-push through tools/verified-tree.sh when every check passed on a clean, unchanged tree. With
    `selected` (the checks the plan selected in each suite) it runs those checks, otherwise whole suites.
    The suites share one verify run, which starts once the load allows (#572); each result records that wait and
    the load averages at the run's start and end. A check's result is {suite, status, log}, its status as the
    verify report gives it, or "void" when the run failed outside any check (environment, setup, slot limiter):
    nothing of such a run counts as passed."""
    if not suites:
        return [], {}, None, stamp_result("", False)
    load_wait = wait_for_load(label)
    logs = state_dir() / "logs"
    logs.mkdir(exist_ok=True)
    log = logs / f"{label}-{time.strftime('%Y%m%dT%H%M%S')}.log"
    ids = None if full or selected is None else [c for s in suites for c in selected[s]]
    selection = () if full else ("--checks", ",".join(ids)) if ids is not None else ("--suites", ",".join(suites))
    argv = [os.path.join(root, "verify.sh"), *selection, "--keep-going", "--jobs", str(slots)]
    # verify.py queues for its own lease of --jobs slots (B10); the label, class and metadata name the run (#650).
    env = verify_env(label, phase, **(meta or {}))
    what = "the full gate" if full else ", ".join(suites) + (f" ({len(ids)} checks)" if ids is not None else "")
    print(f"lane: running {what} in {root} (log {log}); queue: slotfather status", flush=True)
    started, load = time.monotonic(), {"start": load_averages()}
    with open(log, "w") as handle:
        status = subprocess.run(argv, cwd=root, env=env, stdout=handle, stderr=subprocess.STDOUT).returncode
    seconds = round(time.monotonic() - started, 1)
    load["end"] = load_averages()
    failed_checks = []
    text = log.read_text(errors="replace")
    reports = re.findall(r"^Verification report: (.+)$", text, re.M)
    report = read_json(Path(reports[-1].strip())) if reports else None
    if report:
        failed_checks = [row["id"] for row in report.get("checks", []) if row.get("status") not in PASSING]
    # verify.py voids a run whose environment failed (the Rust toolchain refused or changed, #571): no suite of it
    # passed, so a later check reuses none of its results.
    environment = ((report or {}).get("environment") or {}).get("class")
    owners = suite_owners(root, suites) if status or environment else None
    failing = {s: [c for c in failed_checks if owned(owners, s, c)] for s in suites}
    # A failure no check accounts for (setup, slot limiter) fails every suite of the run.
    failed = list(suites) if environment else [s for s in suites if failing[s]] or suites if status else []
    rows = {row.get("id"): row for row in (report or {}).get("checks", [])}
    # A run that stopped at its first checks (#639) did not start the others: a suite with one of them not run and
    # none red neither passed nor failed.
    stopped = (report or {}).get("stopped")
    unstarted = [s for s in suites if stopped and s not in failed and (
        ids is None or any(rows.get(c, {}).get("status", "not_run") == "not_run" for c in selected[s]))]
    if stopped:
        print(f"lane: verify stopped at its first checks (#639): {', '.join(stopped['failed'])} red; "
              f"{stopped['not_run']} heavier checks did not start ({log})", flush=True)
    results = [{"suite": suite, "status": "failed" if suite in failed else "not_run" if suite in unstarted
                else "passed", "exit": status,
                "seconds": seconds, "load_wait": load_wait, "load": load, "log": str(log),
                "failed_checks": failing[suite] if suite in failed else [],
                **({"report": reports[-1].strip()} if reports else {}),
                **({"environment": environment} if environment else {}),
                **({"checks": selected[suite]} if selected is not None else {})}
               for suite in suites]
    void = bool(environment) or bool(status) and not any(failing.values())
    checks = {} if ids is None else {
        check: {"suite": suite, "status": "void" if void else rows.get(check, {}).get("status", "not_run"),
                "log": str(log)}
        for suite in suites for check in selected[suite]}
    stamp = {"stamped": False, "reason": "the run failed"} if status or environment else stamp_result(text, full)
    return results, checks, triage(root, Path(reports[-1].strip()).parent) if status and reports else None, stamp


def reusable(previous: dict, delta: dict) -> dict[str, dict]:
    """The check results of an earlier receipt that a later check of the lane reuses: each passed there, and no
    change since its head (the `delta` plan) selects it. A full delta (a path no check reads, a change that
    selects every check) reuses nothing; nor does a receipt from before per-check results."""
    if delta.get("full") or delta.get("selection") is None:
        return {}
    changed = {row["id"] for row in delta["selection"]}
    return {check: dict(entry, reused_from=entry.get("reused_from") or previous["tree"])
            for check, entry in (previous.get("check_results") or {}).items()
            if entry.get("status") == "passed" and check not in changed}


def combined_results(suites: list[str], selected: dict[str, list[str]] | None, fresh: list[dict],
                     reused: dict[str, dict]) -> list[dict]:
    """Each suite's result for a receipt: the fresh run's, naming every check the plan selects there and those it
    reused; a suite whose every check was reused passes, reused from the tree its first check ran on."""
    ran = {r["suite"]: r for r in fresh}
    results = []
    for suite in suites:
        ids = (selected or {}).get(suite, [])
        kept = [c for c in ids if c in reused]
        if suite in ran:
            result = dict(ran[suite], **({"checks": ids} if selected is not None else {}))
            results.append(dict(result, reused=kept) if kept else result)
        else:
            entries = [reused[c] for c in kept]
            results.append({"suite": suite, "status": "passed", "checks": ids, "failed_checks": [], "reused": kept,
                            "reused_from": entries[0]["reused_from"], "log": entries[0].get("log", "")})
    return results


def lane_ran(lane_id: str) -> tuple[set[str], set[str], set[str]]:
    """What the lane's check and post-merge receipts ran: the checks, the suites, and the suites they ran whole. A
    result without per-check results (a run of whole suites, or a receipt from before them) ran every check of its
    suite."""
    checks, suites, whole = set(), set(), set()
    for kind in ("receipt", "post-merge"):
        receipt = read_json(receipt_path(lane_id, kind)) or {}
        for result in receipt.get("results", []):
            suites.add(result["suite"])
            if "checks" in result:
                checks |= set(result["checks"])
            else:
                whole.add(result["suite"])
    return checks, suites, whole


def toolchain_state(root) -> dict | None:
    """The Rust the tree's tools/rust-toolchain.py resolves now (#571): its resolution, {"refused": why} when it
    refuses, None for a tree that pins no Rust. A receipt certifies only the toolchain it ran with."""
    script = Path(root) / "tools" / "rust-toolchain.py"
    if not (Path(root) / "rust-toolchain.toml").is_file() or not script.is_file():
        return None
    try:
        result = subprocess.run([sys.executable, str(script), "--json"], cwd=root, capture_output=True, text=True,
                                timeout=300)
    except (OSError, subprocess.SubprocessError) as error:
        return {"refused": str(error)}
    if result.returncode:
        return {"refused": (result.stdout + result.stderr).strip()}
    try:
        return json.loads(result.stdout)
    except ValueError:
        return {"refused": f"unreadable resolution: {result.stdout.strip()[:200]}"}


# Red check classification (#568): each red check of a lane check runs again alone, on the lane and on the
# lane's base. Lane red alone and base green: `regression`. Base red too: `pre-existing`. Lane green alone:
# `flaky-under-load`. Only the last two can back a flake ticket, and only they leave the receipt landable.

DEFAULT_RERUNS = 5
LANDABLE = ("flaky-under-load", "pre-existing")
# Test files by name: a tests/ directory, test-*, test_*, *.test.*, *_test.*, *-test.*.
TEST_PATH = re.compile(r"(?:^|/)(?:tests?|__tests__)/|(?:^|/)test[-_][^/]*$|[._-]tests?\.[^/]+$")


def rerun_cap(value: str | None) -> int:
    """STRAYLIGHT_LANE_RERUNS: how many red checks a lane check reruns; the rest stay unclassified."""
    return int(value) if value and value.strip().isdigit() and int(value) > 0 else DEFAULT_RERUNS


def red_checks(results: list[dict]) -> list[str]:
    """The failed checks of the failed results, in order, once each."""
    found = []
    for result in results:
        if result["status"] != "passed":
            found += [c for c in result.get("failed_checks", []) if c not in found]
    return found


def _terminated(signum, _frame):
    raise SystemExit(128 + signum)


@contextlib.contextmanager
def terminable():
    """SIGTERM exits through the finally blocks, which stop the rerun and remove the base checkout."""
    previous = signal.signal(signal.SIGTERM, _terminated)
    try:
        yield
    finally:
        signal.signal(signal.SIGTERM, previous)


def run_child(argv, cwd, env, out) -> int:
    """The child's exit status; when this process exits first, the child gets SIGTERM (verify.py stops its jobs on
    it) and SIGKILL 30 s later."""
    child = subprocess.Popen(argv, cwd=cwd, env=env, stdout=out, stderr=subprocess.STDOUT)
    try:
        return child.wait()
    except BaseException:
        child.terminate()
        try:
            child.wait(timeout=30)
        except subprocess.TimeoutExpired:
            child.kill()
            child.wait()
        raise


class RerunUnavailable(Exception):
    """A rerun could not run alone; its checks stay unclassified."""


# Longer than slotfather's head limit (2700 s) plus a margin: an all-slot rerun that becomes the queue head starts
# by then, while at 1800 s it gave up after holding fitting work back (2026-11-03: twice, 1.5-1.9 h at the head,
# ~1.3 h of smokes and lane checks held back with up to 5 slots idle, then no run, #650).
DEFAULT_RERUN_WAIT = 3300.0


def rerun_wait(value: str | None) -> float:
    """STRAYLIGHT_LANE_RERUN_WAIT: seconds a rerun waits for the whole machine before its checks stay unclassified."""
    try:
        seconds = float(value) if value else DEFAULT_RERUN_WAIT
    except ValueError:
        return DEFAULT_RERUN_WAIT
    return seconds if seconds > 0 else DEFAULT_RERUN_WAIT


@functools.lru_cache(maxsize=None)
def process_scan():
    """tools/agent-hooks/process_scan.py: a worktree's processes and the slotfather leases they run in (#661)."""
    path = Path(__file__).resolve().parent / "agent-hooks" / "process_scan.py"
    loader = importlib.machinery.SourceFileLoader("lane_process_scan", str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def heavy_module():
    """tools/heavy.py beside this file: Straylight's client of the installed slotfather command (#599, #619)."""
    path = Path(__file__).resolve().parent / "heavy.py"
    loader = importlib.machinery.SourceFileLoader("lane_heavy", str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


# Each tools/lane run's lease class (#650). The orchestrator waits on a post-merge smoke, a batch gate and a rerun
# alone (2026-11-03: post-merges waited 1130-1194 s behind measurements); a lane check is ordinary work; the perf
# suite measures, which slotfather ranks batch. Every verify run tools/lane starts takes its lease through verify_env.
SLOT_CLASSES = {"check": "normal", "post-merge": "interactive", "gate": "interactive", "rerun": "interactive",
                "perf": "batch"}


def verify_env(label: str, phase: str, **meta) -> dict:
    """The environment of a verify.sh that tools/lane runs: its lease's label, the phase's class, and metadata
    naming the phase and what the caller adds (lane, ticket, check, sha)."""
    return dict(os.environ, **heavy_module().queue_environment(label, SLOT_CLASSES[phase], phase=phase, **meta))


def lane_meta(record: dict) -> dict:
    """The lane and ticket a lease of `record`'s runs names."""
    return {"lane": record["id"], "ticket": str(record.get("ticket") or "").lstrip("#")}


def alone(argv: list[str], label: str, meta: dict | None = None) -> list[str]:
    """argv under a lease of every machine slot, so no other verification runs beside a rerun: `slotfather run -n
    all --wait STRAYLIGHT_LANE_RERUN_WAIT`, which exits 75 without running argv when the lease does not come in
    time. verify.sh then takes no lease of its own. Raises RerunUnavailable when tools/lane already runs under a
    smaller lease, and without slotfather and a lease: no queue keeps other verifications out, so a rerun would not
    be alone, and a classification from it would call a regression load (review of #610)."""
    module = heavy_module()
    if not module.leased() and module.command() is None:
        raise RerunUnavailable("slotfather is not on PATH, so nothing keeps other verifications beside a rerun; "
                               "it would not run alone")
    count = module.lease_count()
    if count is not None:
        try:
            total = module.total()
        except module.Unavailable:
            total = count
        if count < total:
            raise RerunUnavailable(f"tools/lane runs under a lease of {count} slot(s); a rerun alone needs all {total}")
    return module.wrap("all", label, argv, wait=rerun_wait(os.environ.get("STRAYLIGHT_LANE_RERUN_WAIT")),
                       meta={"phase": "rerun", "kind": "rerun-alone", **(meta or {})}, klass=SLOT_CLASSES["rerun"],
                       yieldable=False)


def rerun_checks(root, ids: list[str], label: str, whole: bool = True,
                 meta: dict | None = None) -> tuple[dict | None, Path, Path | None]:
    """Run the checks in `root` one after another (verify.sh --checks --jobs 1) while holding every verification
    slot: the report (None when there is none), the run's log and its run directory. `whole=False` runs them as
    verify.sh queues them: cheap checks (#639), which on a clean checkout run before the queue and need no slot."""
    logs = state_dir() / "logs"
    logs.mkdir(exist_ok=True)
    log = logs / f"{label}-{time.strftime('%Y%m%dT%H%M%S')}.log"
    verify = [os.path.join(root, "verify.sh"), "--checks", ",".join(ids), "--keep-going", "--jobs", "1"]
    meta = {"check": ",".join(ids), **(meta or {})}
    argv = alone(verify, label, meta) if whole else verify
    print(f"lane: rerunning {', '.join(ids)} {'alone ' if whole else ''}in {root} (log {log})"
          + ("; waiting for every slot" if whole else ""), flush=True)
    with open(log, "w") as handle:
        status = run_child(argv, root, verify_env(label, "rerun", **meta), handle)
    reports = re.findall(r"^Verification report: (.+)$", log.read_text(errors="replace"), re.M)
    if argv != verify and status == heavy_module().TIMED_OUT and not reports:
        raise RerunUnavailable(f"no lease of every machine slot within "
                               f"{rerun_wait(os.environ.get('STRAYLIGHT_LANE_RERUN_WAIT')):g} s (slotfather status)")
    run = Path(reports[-1].strip()).parent if reports else None
    return (read_json(run / "report.json") if run else None), log, run


def rerun_problem(report: dict | None, log: Path) -> str | None:
    """Why a rerun says nothing about its checks, or None."""
    if report is None:
        return f"the rerun wrote no verification report ({log})"
    if report.get("environment"):
        return f"the rerun failed on its environment: {report['environment'].get('class')} ({log})"
    return None


# A check is red alone when it failed, or its producer failed alone (blocked). On the base only a failure of the
# check itself is pre-existing.
RED_ALONE = ("failed", "blocked")


def not_run(row: dict) -> str:
    blocked = f" by {', '.join(row['blocked_by'])}" if row.get("blocked_by") else ""
    return f"{row['status']}{blocked}"


def report_row(report: dict | None, check_id: str) -> dict:
    return next((r for r in (report or {}).get("checks", []) if r.get("id") == check_id), {"status": "not_run"})


def remove_checkout(worktree, path: Path) -> None:
    git(worktree, "worktree", "remove", "--force", "--force", str(path), check=False)
    if path.exists():
        shutil.rmtree(path, ignore_errors=True)
    git(worktree, "worktree", "prune", check=False)


@contextlib.contextmanager
def base_checkout(record: dict, worktree, sha: str):
    """A disposable worktree detached at the lane's base, in the lane's scratch directory, removed on every exit
    path; one that a killed check left behind goes first. The machine-wide Cargo cache (cargo-v2) and Bun's cache
    serve its builds; tools/lane done drops the cache partitions that name it."""
    scratch = Path(record["scratch"][0])
    scratch.mkdir(parents=True, exist_ok=True)
    for stale in scratch.glob("base-*"):
        remove_checkout(worktree, stale)
    path = scratch / f"base-{sha[:12]}"
    try:
        git(worktree, "worktree", "add", "-q", "--detach", str(path), sha)
        yield str(path)
    finally:
        remove_checkout(worktree, path)


def known_checks(root) -> set[str] | None:
    """The check ids the tree's verification plan defines; None for a tree without one."""
    module = verification_plan(root)
    try:
        return {c.id for c in module.checks(Path(root), Path("/nonexistent"), set(module.SUITES), True, False, 1,
                                            bundle=False)} if module else None
    except Exception:
        return None


def keep_run(run: Path | None, label: str) -> Path | None:
    """Copy a run directory out of a checkout about to be removed, into the lane logs."""
    if run is None or not run.is_dir():
        return None
    kept = state_dir() / "logs" / f"{label}-{run.name}"
    shutil.copytree(run, kept, dirs_exist_ok=True)
    return kept


def classify(record: dict, worktree: str, base: str, fresh: list[dict], report: dict | None) -> dict | None:
    """Rerun the red checks of a lane check (at most STRAYLIGHT_LANE_RERUNS) and classify each; None when nothing
    is red. `green` is true when every red check is flaky-under-load or pre-existing.

    A run that stopped at its first checks (#639, the report's `stopped`) has only those red: static checks of
    seconds, which load does not make red, so they rerun only on the base, as verify.sh queues them."""
    failed = [r for r in fresh if r["status"] == "failed"]
    if not failed:
        return None
    first = bool((report or {}).get("stopped"))
    environment = next((r["environment"] for r in failed if r.get("environment")), None)
    if environment:
        return {"skipped": f"environment: {environment}: the run's results do not count, so nothing reran",
                "checks": [], "green": False}
    candidates = red_checks(failed)
    # A red row no suite owns (setup, cleanup) or a failed suite without a red check cannot be rerun.
    unaccounted = sorted({row["id"] for row in (report or {}).get("checks", []) if row.get("status") not in PASSING}
                         - set(candidates)) + [r["suite"] for r in failed if not r.get("failed_checks")]
    cap = rerun_cap(os.environ.get("STRAYLIGHT_LANE_RERUNS"))
    rerun = candidates[:cap]
    load = {"first_run": load_averages()}
    entries = {c: {"check": c, "class": "unclassified", "reason": f"only the first {cap} red checks rerun"}
               for c in candidates[cap:]}
    still_red = []
    if rerun and first:
        still_red = list(rerun)
        for check_id in rerun:
            entries[check_id] = {"check": check_id, "alone": {
                "status": "not rerun", "reason": "a first check (#639): static, so load does not make it red"}}
    elif rerun:
        try:
            alone, log, _ = rerun_checks(worktree, rerun, f"lane-{record['id']}-alone", meta=lane_meta(record))
            problem = rerun_problem(alone, log)
        except RerunUnavailable as error:
            alone, log, problem = None, None, str(error)
        load["alone"] = load_averages()
        for check_id in rerun:
            row = report_row(alone, check_id)
            if problem:
                entries[check_id] = {"check": check_id, "class": "unclassified", "reason": problem}
            elif row["status"] == "passed":
                entries[check_id] = {"check": check_id, "class": "flaky-under-load", "load": load,
                                     "alone": {"status": "passed", "log": str(log)}}
            elif row["status"] in RED_ALONE:
                still_red.append(check_id)
                entries[check_id] = {"check": check_id, "alone": {"status": row["status"], "log": str(log),
                                                                  **({"blocked_by": row["blocked_by"]}
                                                                     if row.get("blocked_by") else {})}}
            else:
                entries[check_id] = {"check": check_id, "class": "unclassified",
                                     "reason": f"the rerun alone did not run it ({not_run(row)}): {log}"}
    if still_red:
        with base_checkout(record, worktree, base) as path:
            known = known_checks(path)
            present = [c for c in still_red if known is None or c in known]
            for check_id in still_red:
                if check_id not in present:
                    entries[check_id].update({"class": "regression", "base": {
                        "sha": base, "status": "absent", "reason": "the base defines no such check"}})
            if present:
                label = f"lane-{record['id']}-base"
                try:
                    report_base, log, run = rerun_checks(path, present, label, whole=not first,
                                                         meta={**lane_meta(record), "on": "base"})
                    problem = rerun_problem(report_base, log)
                except RerunUnavailable as error:
                    report_base, log, run, problem = None, None, None, str(error)
                kept = keep_run(run, label)
                for check_id in present:
                    row = report_row(report_base, check_id)
                    own = kept / Path(row["log"]).name if kept and row.get("log") else None
                    evidence = {"sha": base, "status": row["status"],
                                "log": str(own) if own and own.is_file() else str(log),
                                **({"blocked_by": row["blocked_by"]} if row.get("blocked_by") else {})}
                    if problem:
                        entries[check_id].update({"class": "unclassified", "reason": problem, "base": evidence})
                    elif row["status"] == "passed":
                        entries[check_id].update({"class": "regression", "base": evidence})
                    elif row["status"] == "failed":
                        entries[check_id].update({"class": "pre-existing", "base": evidence})
                    else:
                        # Blocked behind a failed producer, not run or unrun: the base says nothing about the check.
                        entries[check_id].update({"class": "unclassified", "base": evidence,
                                                  "reason": f"the base did not run it ({not_run(row)})"})
    checks = [entries[c] for c in candidates]
    green = bool(checks) and not unaccounted and all(e["class"] in LANDABLE for e in checks)
    return {"base": base, "checks": checks, "load": load, "unaccounted": unaccounted, "green": green,
            **({"first": True} if first else {})}


def classification_lines(classification: dict) -> list[str]:
    if classification.get("skipped"):
        return [f"lane: red checks not classified: {classification['skipped']}"]
    base = classification["base"][:10]
    first = classification.get("first")
    lines = [f"lane: red first checks rerun on the base {base} (#639):" if first
             else f"lane: red checks rerun alone on the lane and on its base {base} (#568):"]
    for entry in classification["checks"]:
        kind, detail = entry["class"], entry.get("reason", "")
        if kind == "regression":
            detail = ("the base defines no such check" if entry["base"]["status"] == "absent"
                      else f"fails {'' if entry.get('alone', {}).get('status') == 'not rerun' else 'alone '}on "
                           f"the lane, the base {base} passes it")
        elif kind == "pre-existing":
            detail = f"the base {base} fails it too ({entry['base']['log']})"
        elif kind == "flaky-under-load":
            detail = (f"passes alone; load averages {'/'.join(map(str, entry['load']['first_run']))} after the "
                      f"lane run, {'/'.join(map(str, entry['load']['alone']))} alone")
        lines.append(f"  {entry['check']}: {kind}: {detail}")
    if classification["unaccounted"]:
        lines.append(f"  not rerun (no check of a suite): {', '.join(classification['unaccounted'])}")
    if classification["green"]:
        lines.append("lane: every red check is flaky-under-load or pre-existing: the receipt is green; a flake "
                     "ticket cites these lines")
    return lines


def first_receipt(record: dict, previous: dict | None, head: str, tree: str, results: list[dict]) -> dict:
    """The lane's first receipt, kept per lane in <id>.first.json, whatever the branch's history does later (an
    amend or rebase). A file from an earlier lane of the same id, registered at another time, does not count."""
    path = receipt_path(record["id"], "first")
    first = read_json(path)
    if first and first.get("lane_created") == record.get("created"):
        return first
    # A receipt from before <id>.first.json carries its first receipt, or is the first one itself.
    first = (previous or {}).get("first") or ({"head": previous.get("head"), "tree": previous.get("tree"),
                                               "failed_checks": red_checks(previous.get("results", []))}
                                              if previous and previous.get("tree") else None)
    first = dict(first or {"head": head, "tree": tree, "failed_checks": red_checks(results)},
                 lane_created=record.get("created"))
    write_json(path, first)
    return first


def changed_red_tests(plan: dict, first: dict) -> list[dict]:
    """Test files the lane changed against its base (the check's plan) whose check was red in its first receipt."""
    failed = first.get("failed_checks") or []
    if not failed:
        return []
    rows = plan.get("checks")
    if rows is None:
        return [{"path": p, "check": None} for p in plan["paths"] if TEST_PATH.search(p)]
    return [{"path": p, "check": row["id"]} for row in rows if row["id"] in failed for p in row["paths"]
            if TEST_PATH.search(p)]


def changed_red_tests_line(tests: list[dict]) -> str:
    named = ", ".join(f"{t['path']} ({t['check']})" if t["check"] else t["path"] for t in tests)
    return (f"lane: test files the lane changed whose check was red in its first receipt: {named}. The reviewer "
            "confirms each change fixes the test rather than hides a regression (#568)")


# Commands

def header(record: dict, rules: list[dict] = ()) -> str:
    ticket = f"#{record['ticket']}" if record["ticket"] != "none" else "none (no ticket)"
    return "\n".join([
        f"Lane {record['id']}: ticket {ticket}",
        f"Branch: {record['branch']} from {record['base']} ({record['base_sha'][:10]})",
        f"Claims: {' '.join(record['claims']) or 'none yet; tools/lane check adds the paths the lane changes'}" +(f" (lands after {', '.join(record['after'])})" if record["after"] else ""),
        # The agent records its worktree at once, so the lane record names it before the first check (#577).
        f"Worktree: {record['worktree'] or 'yours; first run git checkout -B ' + record['branch'] + ' ' + record['base']}"
        + ("" if record["worktree"] else f', then tools/lane adopt {record["id"]} "$PWD" {record["branch"]}'),
        f"Scratch: {record['scratch'][0]} (evidence logs and probes; tools/lane done removes it)",
        f"Cargo target, when the lane needs its own: {record['cargo_targets'][0]}",
        f"Before reporting: tools/lane check {record['id']} in your worktree, on a clean committed tree.",
        f"Report: the block in .agents/skills/orchestrate/IMPLEMENTER.md#report, with "
        f"Receipt: {receipt_path(record['id'])}",
        *rules_block(rules),
    ])


def cache_root() -> Path:
    configured = os.environ.get("STRAYLIGHT_BUILD_CACHE")
    if configured:
        return Path(configured)
    base = Path.home() / "Library/Caches" if sys.platform == "darwin" else Path(
        os.environ.get("XDG_CACHE_HOME") or Path.home() / ".cache")
    return base / "straylight"


def overlapping(claims, other: dict) -> list[tuple[str, str]]:
    return [(mine, theirs) for mine in claims for theirs in other["claims"] if claims_overlap(mine, theirs)]


def widen_claims(lane_id: str, paths: list[str]) -> tuple[list[str], list[dict]]:
    """Add the changed paths outside the lane's claims to them (#574): the paths added, and each overlap of one with
    the claims of another planned or active lane. Lanes declared in sequence (--after either way) may overlap."""
    with locked("state"):
        record = load(lane_id)
        added = [p for p in dict.fromkeys(paths) if not any(matches(c, p) for c in record["claims"])]
        if not added:
            return [], []
        others = [r for r in occupying() if r["id"] != lane_id and r["id"] not in record["after"]
                  and lane_id not in r.get("after", [])]
        overlaps = [{"path": path, "lane": other["id"], "ticket": other["ticket"], "claim": claim}
                    for path in added for other in others for claim in other["claims"] if matches(claim, path)]
        record["claims"] = [*record["claims"], *added]
        save(record)
        ledger(f"claims {lane_id} + {' '.join(added)}"
               + "".join(f" (overlaps {o['lane']}: {o['claim']})" for o in overlaps))
    return added, overlaps


def prepare(cwd, lane_id: str, ticket: str, claims: list[str], base: str | None, after: list[str],
            branch: str | None = None, scratch=()) -> tuple[dict, list[dict]]:
    """The record tools/lane start registers, and the rules its claims touch; nothing is written."""
    record_path(lane_id)
    for claim in claims:
        if claim.startswith("/") or ".." in claim.split("/"):
            raise LaneError(f"claim {claim}: give a glob relative to the repository")
    common = common_dir(cwd)
    base = base or current_branch(cwd) or git(cwd, "rev-parse", "HEAD")
    base_sha = git(cwd, "rev-parse", "--verify", base + "^{commit}")
    integration = next((w["path"] for w in worktree_list(cwd) if w.get("branch") == base), None)
    rules = rules_for(claims, git(cwd, "rev-parse", "--show-toplevel"))
    record = {"id": lane_id, "ticket": str(ticket).lstrip("#"), "branch": branch or f"lane/{lane_id}",
              "base": base, "base_sha": base_sha, "claims": claims, "after": after, "common_dir": common,
              "integration": integration, "worktree": None, "status": "planned", "created": now(),
              "scratch": [str(state_dir() / f"{lane_id}.scratch"), *(os.path.realpath(s) for s in scratch)],
              "cargo_targets": [str(cache_root() / f"lane-{lane_id}-target")], "overrides": [],
              "rules": [rule["name"] for rule in rules]}
    return record, rules


def register(record: dict, rules: list[dict], force_reason: str | None, create: bool) -> None:
    """Enforce the cap, disk, load and claims, save the record and print its brief header."""
    lane_id, claims, after = record["id"], record["claims"], record["after"]
    with locked("state"):
        existing = read_json(record_path(lane_id))
        if existing and existing["status"] != "done":
            raise LaneError(f"lane {lane_id} exists ({existing['status']}); finish it with tools/lane done")
        others = [r for r in lanes() if r["id"] != lane_id]
        for name in after:
            if name not in {r["id"] for r in others if r["status"] != "done"}:
                raise LaneError(f"--after {name}: no active lane by that name")
        active = occupying(others)
        refusals = []
        info = host()
        if len(active) >= MAX_LANES:
            refusals.append(f"{len(active)} lanes are active ({', '.join(r['id'] for r in active)}); "
                            f"the cap is {MAX_LANES} ({CAP_SOURCE}): land one (a landed lane frees its slot)")
        if info["disk_free_gb"] < MIN_DISK_GB:
            refusals.append(f"free disk is {info['disk_free_gb']:.0f} GB, under {MIN_DISK_GB} GB: "
                            "run tools/lane done on landed lanes")
        if info["load15"] > load_limit(info["cores"]):
            refusals.append(f"load15 is {info['load15']:.1f}, above {LOAD_FACTOR}x{info['cores']} cores")
        if refusals and not force_reason:
            raise LaneError("refused:\n- " + "\n- ".join(refusals))
        for other in active:
            pairs = [] if other["id"] in after else overlapping(claims, other)
            if pairs:
                listed = ", ".join(f"{m} with {t}" for m, t in pairs)
                raise LaneError(f"claims overlap lane {other['id']} (#{other['ticket']}): {listed}. Run the lanes "
                                f"in sequence: start this one with --after {other['id']}")
        Path(record["scratch"][0]).mkdir(exist_ok=True)
        if refusals:
            record["overrides"].append({"at": now(), "reason": force_reason, "refusals": refusals})
            ledger(f"override start {lane_id}: {force_reason} (refusals: {'; '.join(refusals)})")
        if create:
            main = main_checkout(record["common_dir"])
            path = os.path.join(main, ".claude", "worktrees", f"lane-{lane_id}")
            git(main, "worktree", "add", "-q", "-b", record["branch"], path, record["base_sha"])
            record.update(worktree=os.path.realpath(path), status="active")
        save(record)
        ledger(f"start {lane_id} ticket={record['ticket']} branch={record['branch']} "
               f"base={record['base']}@{record['base_sha'][:10]} claims={' '.join(claims)} "
               f"after={','.join(after) or '-'} cap={MAX_LANES} ({CAP_SOURCE}) {host_fields(info)}")
    print(header(record, rules))


def start(args) -> int:
    claims = [c for claim in args.claims for c in claim.split()]
    record, rules = prepare(os.getcwd(), args.id, args.ticket, claims, args.base, args.after, args.branch, args.scratch)
    register(record, rules, args.force_reason, args.create)
    return 0


# The queue (#446)

def queue_path() -> Path:
    configured = os.environ.get("STRAYLIGHT_LANE_QUEUE")
    return Path(os.path.expanduser(configured)) if configured else state_dir().parent / "queue" / "queue.toml"


def read_queue() -> tuple[dict, list[dict]]:
    """The queue's top-level settings and its [[lane]] entries in rank order, each checked."""
    import tomllib  # Python 3.11+; imported here so the janitor's /usr/bin/python3 can still load this file
    path = queue_path()
    try:
        data = tomllib.loads(path.read_text())
    except FileNotFoundError:
        raise LaneError(f"no queue at {path}: rank the next tickets there as [[lane]] entries "
                        "(docs/agents/orchestration.md#queue)") from None
    except (OSError, tomllib.TOMLDecodeError) as error:
        raise LaneError(f"{path}: {error}") from None
    entries = data.get("lane", [])
    if not isinstance(entries, list):
        raise LaneError(f"{path}: lane must be an array of tables, [[lane]]")
    for index, entry in enumerate(entries, 1):
        problem = None
        if not isinstance(entry.get("id"), str) or not ID.match(entry["id"]):
            problem = "id: use letters, digits, '_' or '-'"
        elif not isinstance(entry.get("ticket"), (int, str)) or not re.fullmatch(r"#?\d+|none", str(entry["ticket"])):
            problem = "ticket: an issue number, or \"none\""
        elif (not isinstance(entry.get("claims"), list) or not entry["claims"]
              or not all(isinstance(c, str) and c for c in entry["claims"])):
            problem = "claims: a non-empty list of path globs"
        elif not isinstance(entry.get("after", []), list) or not all(isinstance(a, str) for a in entry.get("after", [])):
            problem = "after: a list of lane ids"
        elif not isinstance(entry.get("blocked", ""), (str, bool)):
            problem = "blocked: why it waits (an owner question, hardware), or false"
        if problem:
            raise LaneError(f"{path} entry {index} ({entry.get('id', '?')}): {problem}")
    return data, entries


def queue_states(entries: list[dict], records: list[dict]) -> list[tuple[dict, str | None]]:
    """Each entry with why it is not ready, or None when it is."""
    by_id = {r["id"]: r for r in records}
    active = occupying(records)
    states = []
    for entry in entries:
        reason = None
        blocked = entry.get("blocked")
        if blocked:
            reason = f"blocked: {blocked}" if isinstance(blocked, str) else "blocked"
        elif entry["id"] in by_id:
            reason = f"registered ({by_id[entry['id']]['status']})"
        else:
            waiting = [f"{name} ({by_id[name]['status'] if name in by_id else 'not started'})"
                       for name in entry.get("after", []) if (by_id.get(name) or {}).get("status") not in LANDED]
            if waiting:
                reason = "waits for " + ", ".join(waiting)
            for other in [] if waiting else active:
                pairs = overlapping(entry["claims"], other)
                if pairs:
                    reason = f"claims overlap lane {other['id']}: " + ", ".join(f"{m} with {t}" for m, t in pairs)
                    break
        states.append((entry, reason))
    return states


def next_ready() -> tuple[dict, dict | None, list[tuple[dict, str | None]]]:
    """The queue's settings, its first ready entry (None when nothing is ready) and every entry's state."""
    data, entries = read_queue()
    states = queue_states(entries, lanes())
    return data, next((entry for entry, reason in states if reason is None), None), states


def next_lane(args) -> int:
    data, ready, states = next_ready()
    for entry, reason in states:
        if reason and entry is not ready:
            print(f"  skip {entry['id']} (#{str(entry['ticket']).lstrip('#')}): {reason}", file=sys.stderr)
    if ready is None:
        print(f"No ready entry in {queue_path()}", file=sys.stderr)
        return 3
    record, rules = prepare(os.getcwd(), ready["id"], ready["ticket"], list(ready["claims"]),
                            args.base or data.get("base"), [])
    if args.start:
        register(record, rules, args.force_reason, args.create)
    else:
        print(header(record, rules))
    # An entry may carry its brief (tools/ui-libs.py queues one, #588): it follows the header into the lane's prompt.
    if isinstance(ready.get("brief"), str) and ready["brief"].strip():
        print("Brief:\n" + ready["brief"].strip())
    return 0


def adopt_worktree(record: dict, worktree: str, branch: str) -> None:
    path = os.path.realpath(worktree)
    if not os.path.isdir(path) or common_dir(path) != record["common_dir"]:
        raise LaneError(f"adopt refused: {path} is not a worktree of {main_checkout(record['common_dir'])}")
    actual = current_branch(path)
    if actual != branch:
        raise LaneError(f"adopt refused: {path} is on {actual or 'a detached HEAD'}, not {branch}")
    for other in lanes():
        if other["id"] != record["id"] and other["status"] != "done" and other.get("worktree") == path:
            raise LaneError(f"adopt refused: lane {other['id']} owns {path}")
    record.update(worktree=path, branch=branch, status="active" if record["status"] == "planned" else record["status"],
                  adopted=now())
    save(record)
    ledger(f"adopt {record['id']} worktree={path} branch={branch}")


def adopt(args) -> int:
    with locked("state"):
        record = load(args.id)
        if record["status"] not in ("planned", "active"):
            raise LaneError(f"adopt refused: lane {args.id} is {record['status']}")
        adopt_worktree(record, args.worktree, args.branch)
    print(f"Lane {args.id} adopted {record['worktree']} on {args.branch}")
    return 0


def check(args) -> int:
    record = load(args.id)
    if record["status"] == "planned":
        cwd = git(os.getcwd(), "rev-parse", "--show-toplevel", check=False)
        if not cwd or current_branch(cwd) != record["branch"]:
            raise LaneError(f"lane {args.id} has no worktree yet: run it from a worktree on {record['branch']}, "
                            "or register one with tools/lane adopt")
        adopt_worktree(record, cwd, record["branch"])
    if record["status"] != "active":
        raise LaneError(f"lane {args.id} is {record['status']}; check runs before landing")
    worktree = record["worktree"]
    if current_branch(worktree) != record["branch"]:
        raise LaneError(f"{worktree} is on {current_branch(worktree)}, not the lane branch {record['branch']}")
    if dirty(worktree):
        raise LaneError("commit your work (or set it aside in a WIP commit) first: the receipt covers a committed "
                        "tree\n" + dirty(worktree))
    head, tree = git(worktree, "rev-parse", "HEAD"), git(worktree, "rev-parse", "HEAD^{tree}")
    path = receipt_path(args.id)
    previous = read_json(path)
    # A receipt and its results certify the Rust they ran with (#571): another one, or none now, voids them.
    toolchain = toolchain_state(worktree)
    same_rust = previous is not None and previous.get("toolchain") == toolchain
    if previous and previous.get("tree") == tree and previous.get("status") == "green" and not args.rerun:
        if same_rust:
            print(f"Receipt current: green for tree {tree} ({path})")
            return 0
        print("lane: the Rust toolchain changed since the receipt (#571); running the checks again")
    base_ref = git(worktree, "rev-parse", "--verify", "--quiet", record["base"] + "^{commit}", check=False)
    base = git(worktree, "merge-base", "HEAD", base_ref or record["base_sha"])
    plan = plan_for(worktree, base)
    suites = plan["selected"]
    selected = plan["by_suite"]
    reused = {}
    if (selected is not None and previous and same_rust and previous.get("head") and not args.rerun
            and git_ok(worktree, "cat-file", "-e", previous["head"])):
        # Per check: a check that passed for an earlier tree of the lane and that no change since selects.
        wanted = {c for ids in selected.values() for c in ids}
        reused = {c: e for c, e in reusable(previous, plan_for(worktree, previous["head"])).items() if c in wanted}
    outside = [p for p in plan["paths"] if not p.startswith(UNCLAIMED)
               and not any(matches(c, p) for c in record["claims"])]
    added, overlaps = widen_claims(args.id, outside)
    if added:
        print(f"lane: claims widened: {', '.join(added)}")
    for overlap in overlaps:
        print(f"lane: warning: {overlap['path']} overlaps the claims of lane {overlap['lane']} (#{overlap['ticket']}): "
              f"{overlap['claim']}; tell the orchestrator, the two lanes may conflict when they land")
    for unowned in plan.get("unowned", []):
        print(f"lane: no check reads {unowned}, so the plan is the full gate: declare its readers in "
              "tools/verification_plan.py")
    started = now()
    # A lane check runs its selection even for a full plan (every check of the gate): no stamp; only promote's
    # batch gate stamps the tree it promotes.
    remaining = None if selected is None else {s: [c for c in ids if c not in reused] for s, ids in selected.items()}
    if args.slots:
        decision = given_jobs(args.slots, "--slots")
    elif remaining is None or any(remaining.values()):
        decision = check_jobs(host())
    else:
        decision = {"jobs": 1, "reason": "nothing to run"}
    fresh, ran, triaged, classification, stopped = lane_run(record, worktree, base, suites, remaining,
                                                            decision["jobs"])
    results = combined_results(suites, selected, fresh, reused)
    check_results = {} if selected is None else {
        c: reused.get(c) or ran.get(c) or {"suite": s, "status": "not_run"} for s, ids in selected.items() for c in ids}
    status = "green" if all(r["status"] == "passed" for r in results) else "red"
    # The lane's first receipt: a test file the lane changes whose check was red there is named.
    first = first_receipt(record, previous, head, tree, results)
    # A run that stopped at its first checks stays red: its heavier checks did not run.
    if status == "red" and classification and classification["green"] and not stopped:
        status = "green"
    changed_tests = changed_red_tests(plan, first)
    info = host()
    write_json(path, {"version": 1, "lane": args.id, "ticket": record["ticket"], "branch": record["branch"],
                      "head": head, "tree": tree, "base": base, "suites": suites, "reasons": plan["reasons"],
                      "checks": selected, "selection": plan["selection"], "check_results": check_results,
                      "unowned": plan.get("unowned", []), "full": plan["full"],
                      "outside_claims": outside, "claims_added": added, "claim_overlaps": overlaps,
                      "toolchain": toolchain, "jobs": decision["jobs"], "jobs_decision": decision,
                      "results": results, "triage": triaged, "classification": classification,
                      "first": first, "changed_red_tests": changed_tests, "stopped": stopped,
                      "status": status, "host": info, "started": started, "finished": now()})
    classes = ",".join(f"{e['check']}={e['class']}" for e in (classification or {}).get("checks", []))
    ledger(f"check {args.id} tree={tree} {status} suites={','.join(suites) or '-'} "
           f"checks={len(check_results) - len(reused)} reused={len(reused)} jobs={decision['jobs']} "
           f"classified={classes or '-'} {host_fields(info)}")
    for result in results:
        note = (f" (reused from tree {result['reused_from'][:10]})" if result.get("reused_from")
                else f" ({len(result['reused'])} of {len(result['checks'])} checks reused)" if result.get("reused")
                else "")
        failed = f" failed checks: {', '.join(result['failed_checks'])}" if result.get("failed_checks") else ""
        print(f"  {result['suite']}: {result['status']}{note}{failed}  {result['log']}")
    if triaged:
        print(triaged)
    if classification:
        print("\n".join(classification_lines(classification)))
    if changed_tests:
        print(changed_red_tests_line(changed_tests))
    if stopped:
        print(f"lane: stopped at the first checks (#639): {', '.join(stopped['failed'])} red, so the "
              f"{stopped['not_run']} heavier checks did not start. Fix them, commit and run tools/lane check again.")
    print(f"Receipt {status} for tree {tree}: {path}")
    return 0 if status == "green" else 1


def lane_run(record: dict, worktree: str, base: str, suites: list[str], remaining: dict[str, list[str]] | None,
             slots: int) -> tuple[list[dict], dict[str, dict], str | None, dict | None, dict | None]:
    """Run the lane's checks that are left and classify the red ones (#568): (results, check results, triage,
    classification, stopped).

    verify.sh stops at its first checks (the preflight and the cheap tier, #639) when one is red, before any heavier
    check starts: `stopped`, from its report, and the lane check is red. Only when every red first check is red on
    the base too (pre-existing) do the heavier checks run, once, in a second run whose results join the first's."""
    def attempt(selection):
        fresh, ran, triaged, _ = run_suites(worktree, [s for s in suites if selection is None or selection.get(s)],
                                            f"lane-{record['id']}", slots, selected=selection,
                                            meta=lane_meta(record))
        classification, report = None, None
        if any(r["status"] != "passed" for r in fresh):
            run = next((Path(r["report"]).parent for r in fresh if r.get("report")), None)
            report = read_json(run / "report.json") if run else None
            with terminable():
                classification = classify(record, worktree, base, fresh, report)
            if classification and run:
                # tools/gate-triage.py reads the classification beside the run's report (rerun.json).
                write_json(run / "rerun.json", classification)
                triaged = triage(worktree, run) or triaged
        return fresh, ran, triaged, classification, (report or {}).get("stopped")

    fresh, ran, triaged, classification, stopped = attempt(remaining)
    if not (stopped and classification and classification["green"] and remaining is not None):
        return fresh, ran, triaged, classification, stopped
    rest = {s: [c for c in ids if (ran.get(c) or {}).get("status") == "not_run"] for s, ids in remaining.items()}
    if not any(rest.values()):
        return fresh, ran, triaged, classification, None
    print("lane: every red first check is red on the base too (pre-existing); running the heavier checks", flush=True)
    more, ran_more, triaged_more, classified_more, stopped = attempt(rest)
    return (joined_results(fresh, more), {**ran, **ran_more},
            "\n".join(t for t in (triaged, triaged_more) if t) or None,
            joined_classification(classification, classified_more), stopped)


def joined_results(first: list[dict], second: list[dict]) -> list[dict]:
    """Each suite's result over two runs of a lane check (#639): the second run's, red when either run's was, with
    the failed checks of both."""
    later = {r["suite"]: r for r in second}
    joined = []
    for result in first:
        other = later.pop(result["suite"], None)
        if other is None:
            joined.append(result)
            continue
        failed = result["failed_checks"] + [c for c in other["failed_checks"] if c not in result["failed_checks"]]
        joined.append(dict(other, status="failed" if "failed" in (result["status"], other["status"])
                           else other["status"], failed_checks=failed, first_log=result["log"]))
    return joined + list(later.values())


def joined_classification(first: dict, second: dict | None) -> dict:
    """The classification of two runs of a lane check (#639): green when both runs' red checks are landable."""
    if second is None:
        return first
    return dict(second, checks=first["checks"] + second.get("checks", []),
                unaccounted=first["unaccounted"] + second.get("unaccounted", []),
                green=first["green"] and second["green"])


def failed_items(failed: list[dict]) -> list[tuple[str, str]]:
    """Each failed check of the failed results with its suite, once each; a suite whose failure no check accounts
    for stands as its own item."""
    items = [(check, result["suite"]) for result in failed for check in result.get("failed_checks", [])]
    return list(dict.fromkeys(items)) or [(result["suite"], result["suite"]) for result in failed]


def touched_lines(failed: list[tuple[str, str]], integration: str, merge: str) -> list[str]:
    """The lanes in the merge, newest first, whose checks ran each failed (check, suite) item: the check itself, or
    its whole suite (review of #422, finding 1); for a suite item, any check of the suite. A lane that landed after
    the merge, while its smoke ran (#573), is not in it."""
    landed = [r for r in sorted(lanes(), key=lambda r: r.get("landed", {}).get("at", ""), reverse=True)
              if r.get("landed", {}).get("integration") == integration
              and git_ok(integration, "merge-base", "--is-ancestor", r["landed"]["merge"], merge)]
    ran = {r["id"]: lane_ran(r["id"]) for r in landed}

    def covers(lane_id, item, suite):
        checks, suites, whole = ran[lane_id]
        return item in checks or suite in whole or item == suite and suite in suites

    lines = []
    for item, suite in failed:
        names = [f"{r['id']} (#{r['ticket']})" for r in landed if covers(r["id"], item, suite)]
        lines.append(f"  {item}: {', '.join(names) or 'no recorded lane'}")
    return lines


SMOKE_WORKTREE = "smoke"


@contextlib.contextmanager
def smoke_checkout(common: str, merge: str):
    """A worktree detached at the merge for its post-merge smoke (#573): the first free one of
    <main checkout>/.claude/worktrees/smoke-<n>, which its lock file beside it holds while a smoke runs. Smokes
    overlap, each on its own merge, while the integration worktree moves on; the checkouts stay and keep their builds
    warm for the next smokes, as the batch gate's does."""
    main = main_checkout(common)
    root = Path(main) / ".claude" / "worktrees"
    root.mkdir(parents=True, exist_ok=True)
    git(main, "worktree", "prune", check=False)
    listed = {w["path"] for w in worktree_list(main)}
    index = 0
    while True:
        path = os.path.realpath(root / f"{SMOKE_WORKTREE}-{index}")
        handle = open(root / f".{SMOKE_WORKTREE}-{index}.lock", "a")
        try:
            fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            handle.close()
            index += 1
            continue
        if path in listed or not os.path.exists(path):
            break
        # A directory that is not a worktree is someone else's: leave it.
        handle.close()
        index += 1
    try:
        if path in listed:
            git(path, "checkout", "-q", "--force", "--detach", merge)
            # Untracked files an earlier smoke left; ignored build output stays warm.
            git(path, "clean", "-fdq")
        else:
            git(main, "worktree", "add", "-q", "--detach", path, merge)
        yield path
    finally:
        handle.close()


def land(args) -> int:
    with locked("land", f"lane: waiting for another land's merge (lock {state_dir() / '.land.lock'})"):
        record = load(args.id)
        if record["status"] != "active":
            raise LaneError(f"land refused: lane {args.id} is {record['status']}" +
                            ("; it has no worktree yet" if record["status"] == "planned" else ""))
        for name in record["after"]:
            if load(name)["status"] not in LANDED:
                raise LaneError(f"land refused: lane {args.id} is declared to land after {name}, which has not landed")
        main = main_checkout(record["common_dir"])
        tip = git(main, "rev-parse", "--verify", record["branch"] + "^{commit}")
        tree = git(main, "rev-parse", tip + "^{tree}")
        receipt = read_json(receipt_path(args.id))
        problem = None
        if not receipt:
            problem = f"no receipt for lane {args.id}: run tools/lane check {args.id} in its worktree"
        elif receipt.get("tree") != tree:
            problem = (f"the receipt is stale: it covers tree {receipt.get('tree')}, the lane tip {tip[:10]} has tree "
                       f"{tree}; rerun tools/lane check {args.id}")
        elif receipt.get("status") != "green":
            # A suite whose checks did not start behind a red first check (#639) is named apart from the red ones.
            results = receipt.get("results", [])
            failed = [r["suite"] for r in results if r["status"] not in ("passed", "not_run")]
            unstarted = [r["suite"] for r in results if r["status"] == "not_run"]
            problem = (f"the receipt for tree {tree} is red ({', '.join(failed)}"
                       + (f"; not run: {', '.join(unstarted)}" if unstarted else "") + ")")
            entries = [e for e in (receipt.get("classification") or {}).get("checks", [])
                       if e["class"] == "regression"]
            if entries:
                alone = all((e.get("alone") or {}).get("status") != "not rerun" for e in entries)
                problem += (f"; regression: {', '.join(e['check'] for e in entries)} fails "
                            f"{'alone ' if alone else ''}on the lane and passes on its base "
                            f"{receipt['classification']['base'][:10]}")
        if problem and not args.force_reason:
            raise LaneError("land refused: " + problem)
        if problem:
            record.setdefault("overrides", []).append({"at": now(), "reason": args.force_reason, "refusals": [problem]})
            ledger(f"override land {args.id}: {args.force_reason} ({problem})")
        if not args.into and not record.get("integration"):
            raise LaneError(f"no worktree has {record['base']} checked out; give --into <integration worktree>")
        integration = os.path.realpath(args.into or record["integration"])
        if dirty(integration) or os.path.exists(git(integration, "rev-parse", "--git-path", "MERGE_HEAD")):
            raise LaneError(f"land refused: {integration} has uncommitted changes or a merge in progress")
        onto = current_branch(integration)
        if onto in PROMOTED:
            # promote waits only for lanes not yet in dev (#570): a lane landed on dev or main is reviewed first.
            reviewed, state = review_state(args.id)
            if not reviewed and not review_exemption(record):
                if not args.force_reason:
                    raise LaneError(f"land refused: {integration} is on {onto}, which promote would not hold for "
                                    f"this lane's review ({state}); run tools/lane review {args.id} and mark its "
                                    "findings first, or land into the integration branch")
                record.setdefault("overrides", []).append({"at": now(), "reason": args.force_reason,
                                                           "refusals": [f"unreviewed land onto {onto}"]})
                ledger(f"override land {args.id} onto {onto} unreviewed: {args.force_reason} ({state})")
            else:
                ledger(f"land {args.id} onto {onto}: {state}")
        previous = git(integration, "rev-parse", "HEAD")
        if git_ok(integration, "merge-base", "--is-ancestor", tip, previous):
            raise LaneError(f"land refused: {record['branch']} ({tip[:10]}) is already in {integration}")
        ticket = f" (#{record['ticket']})" if record["ticket"] != "none" else ""
        message = args.message or f"Merge {record['branch']}{ticket}"
        # The landing lock lets the merge move an integration worktree that is on dev or main (B2).
        with landing(record["common_dir"], f"tools/lane land {args.id} (pid {os.getpid()})", args.wait) as env:
            merged = subprocess.run(["git", *RELEASE_NOTES_MERGE, "merge", "--no-ff", "-m", message, record["branch"]],
                                    cwd=integration, capture_output=True, text=True, env=env)
            if merged.returncode:
                conflicts = git(integration, "diff", "--name-only", "--diff-filter=U", check=False)
                subprocess.run(["git", "merge", "--abort"], cwd=integration, capture_output=True, env=env)
        if merged.returncode:
            ledger(f"land {args.id} conflict: {conflicts.replace(chr(10), ' ')}")
            raise LaneError(f"merge conflict, integration left at {previous[:10]}; send it back to the lane:\n"
                            f"{conflicts or merged.stdout + merged.stderr}")
        merge = git(integration, "rev-parse", "HEAD")
        record.update(status="landed", landed={"merge": merge, "previous": previous, "tip": tip, "tree": tree,
                                               "integration": integration, "at": now(), "keep": bool(args.keep)})
        save(record)
        ledger(f"land {args.id} merge={merge} previous={previous}")
    # The land lock is free from here on (#573): the next land merges while this merge's smoke runs on its own
    # checkout of the merge, since the integration worktree moves on.
    with smoke_checkout(record["common_dir"], merge) as checkout:
        # The lane check ran the checks its diff affects. After the merge every land runs the same smoke
        # (#446): everything builds, structure, tooling and fast checks. A merge whose plan selects only the
        # structure checks (documentation) runs that plan. The full gate waits for promote, once per batch.
        plan = plan_for(checkout, previous)
        # The independent review (#570) runs beside the smoke and never holds the land; promote waits for it.
        # A documentation-only merge (*.md and docs/**, not the steering files) and a review's fix round need none.
        with locked("state"):
            record = load(args.id)
            record["landed"].update(docs_only=documentation_only(plan["paths"]))
            save(record)
        print(f"lane: {start_lane_review(record)}", flush=True)
        kind, rows = post_merge_selection(checkout, plan)
        merge_tree = git(checkout, "rev-parse", "HEAD^{tree}")
        # #640: what the lane's green receipt already verified does not run again.
        kind, rows, narrowing = narrow_smoke(checkout, receipt, record["landed"], merge_tree, kind, rows)
        lane_verified = narrowing.pop("lane_verified", {})
        suites, selected = (plan["selected"], None) if rows is None else (suites_of(rows), by_suite(rows))
        info = host()
        if not suites:
            decision = {"jobs": 0, "reason": "nothing to run"}
        else:
            decision = given_jobs(args.slots, "--slots") if args.slots else post_merge_jobs(info)
        slots = decision["jobs"]
        results, check_results, triaged, stamp = run_suites(checkout, suites, f"post-merge-{args.id}", slots,
                                                            selected=selected, phase="post-merge",
                                                            meta=lane_meta(record))
    status = "green" if all(r["status"] == "passed" for r in results) else "red"
    post = receipt_path(args.id, "post-merge")
    info = host()
    write_json(post, {"version": 1, "lane": args.id, "merge": merge, "base": previous,
                      "tree": merge_tree, "checkout": checkout, "kind": kind,
                      "jobs": slots, "jobs_decision": decision, "suites": suites, "full": False,
                      "reasons": plan["reasons"], "checks": selected, "selection": rows, "narrowing": narrowing,
                      "check_results": {**lane_verified, **check_results},
                      "results": results, "triage": triaged, "status": status, "verified_tree": stamp,
                      "host": info, "finished": now()})
    # Reloaded: a review hand-over may have changed the record during the smoke.
    with locked("state"):
        record = load(args.id)
        record["post_merge"] = {"status": status, "receipt": str(post)}
        save(record)
    verified = len(lane_verified)
    ledger(f"post-merge {args.id} {status} {kind} jobs={slots} suites={','.join(suites) or '-'} "
           + (f"lane_verified={verified} " if narrowing.get("narrowed") else "")
           + f"{host_fields(info)} merge={merge}")
    ids = [c for s in suites for c in selected[s]] if selected is not None else None
    what = (", ".join(ids) if ids is not None and len(ids) <= 8 else f"{len(ids)} checks" if ids is not None
            else ", ".join(suites)) or "no suites affected"
    prefix = {"smoke": "smoke: ", "narrowed": "narrowed smoke: "}.get(kind, "")
    if kind == "skip" and merge_tree == narrowing["receipt_tree"]:
        what = f"skipped: the lane's green receipt verified the merge tree {merge_tree[:10]}"
    elif kind == "skip":
        brought = ", ".join(narrowing["integration_paths"][:3]) + (", ..." if len(narrowing["integration_paths"]) > 3
                                                                    else "")
        what = (f"skipped: what the integration brought in ({brought}) selects no smoke check; the lane's green "
                f"receipt stands for {verified}")
    elif narrowing.get("narrowed"):
        what += f"; the lane's receipt stands for {verified} more"
    elif narrowing.get("reason") and rows:
        what += f"; whole, since {narrowing['reason']}"
    print(f"Landed {record['branch']} as {merge[:10]} on {current_branch(integration) or integration}; "
          f"post-merge {status} ({prefix}{what})")
    if receipt and receipt.get("changed_red_tests"):
        print(changed_red_tests_line(receipt["changed_red_tests"]))
    if status == "green":
        reviewed, state = review_state(args.id)
        if reviewed or args.keep:
            finish_landed(args.id, args.keep)
        else:
            # The fix round runs in the lane's worktree, where a resumed agent keeps its context (#570).
            print(f"Lane {args.id} kept for its review ({state}): it holds no slot; marking its last finding "
                  f"finishes it (" + MARK_HELP.format(id=args.id) + ")")
        return 0
    # A suite whose checks did not start because the first checks were red (#639) is not one of the failures.
    failed = [r for r in results if r["status"] == "failed"]
    for result in failed:
        print(f"  {result['suite']}: failed checks {', '.join(result['failed_checks']) or '(see log)'}  {result['log']}")
    if triaged:
        print(triaged)
    head = git(integration, "rev-parse", "HEAD")
    if head != merge:
        print(f"{integration} has moved on to {head[:10]} since; this smoke checked the merge {merge[:10]}.")
    print(f"The merge {merge[:10]} stays in place, marked red. Lanes in it whose checks ran the failed checks:")
    print("\n".join(touched_lines(failed_items(failed), integration, merge)))
    return 1


# The batch gate (#446): the full gate once per batch, at promote.

def stamped_trees(common: str) -> set[str]:
    """The trees a full verify.sh run stamped (tools/verified-tree.sh), from the common Git directory."""
    try:
        rows = (Path(common) / "verified-trees").read_text().splitlines()
    except OSError:
        return set()
    return {row.split()[0] for row in rows if row.split()}


def verified(cwd, common: str, sha: str) -> bool:
    """Whether pre-push would take the SHA's tree: stamped, or (with the hook) differing only in documentation."""
    if git(cwd, "rev-parse", sha + "^{tree}") in stamped_trees(common):
        return True
    top = git(cwd, "rev-parse", "--show-toplevel")
    script = Path(top) / "tools" / "verified-tree.sh"
    if not (Path(top) / ".githooks" / "pre-push").is_file() or not script.is_file():
        return False
    return subprocess.run([str(script), "check", sha], cwd=top, capture_output=True).returncode == 0


def gate_worktree(common: str, sha: str) -> str:
    """The batch gate's own worktree, detached at the SHA, so lanes keep landing on the integration worktree
    while the gate runs and its builds stay warm from batch to batch."""
    main = main_checkout(common)
    path = os.path.realpath(os.path.join(main, ".claude", "worktrees", GATE_WORKTREE))
    if path in {w["path"] for w in worktree_list(main)}:
        # The gate worktree belongs to promote: reset whatever a previous run left in tracked files.
        git(path, "checkout", "-q", "--force", "--detach", sha)
    elif os.path.exists(path):
        raise LaneError(f"{path} exists but is not a worktree of {main}; move it aside")
    else:
        git(main, "worktree", "add", "-q", "--detach", path, sha)
    return path


def bisect_list(cwd, common: str, sha: str, depth: int = 500) -> tuple[str | None, list, list]:
    """The newest first-parent ancestor of the SHA with a stamped tree, and the merges and other commits after it,
    oldest first."""
    stamped = stamped_trees(common)
    green, merges, direct = None, [], []
    for row in git(cwd, "log", "--first-parent", f"-n{depth}", "--format=%H %T %P%x1f%s", sha).splitlines():
        head, _, subject = row.partition("\x1f")
        commit, tree, *parents = head.split()
        if tree in stamped:
            green = commit
            break
        (merges if len(parents) > 1 else direct).append((commit, subject))
    return green, merges[::-1], direct[::-1]


def bisect_lines(cwd, common: str, sha: str) -> list[str]:
    green, merges, direct = bisect_list(cwd, common, sha)
    by_merge = {r["landed"]["merge"]: r["id"] for r in lanes() if r.get("landed")}
    since = (f"since the last green verified tree {green[:10]}" if green
             else f"among the last 500 first-parent commits of {sha[:10]} (none has a verified tree)")
    lines = [f"Lane merges {since}, oldest first; bisect these:"]
    lines += [f"  {c[:10]} {s}" + (f"  lane {by_merge[c]}" if c in by_merge else "") for c, s in merges] or ["  none"]
    if direct:
        lines.append("Other commits on the integration branch since then:")
        lines += [f"  {c[:10]} {s}" for c, s in direct]
    return lines


def batch_gate(cwd, common: str, sha: str, jobs: int | None) -> None:
    """Run the full gate on the SHA in the gate worktree; return once its tree is stamped, else refuse.

    One promote at a time holds the gate worktree, from its checkout to the end of verify: a second checkout under a
    running gate changed the tree that gate was verifying (#454)."""
    with locked("promote", f"lane: waiting for the batch gate of another promote (lock {state_dir() / '.promote.lock'})"):
        if verified(cwd, common, sha):
            print(f"lane: {sha[:10]}'s tree was verified while this promote waited; no batch gate needed")
            return
        run_batch_gate(cwd, common, sha, jobs)


def run_batch_gate(cwd, common: str, sha: str, jobs: int | None) -> None:
    path = gate_worktree(common, sha)
    logs = state_dir() / "logs"
    logs.mkdir(exist_ok=True)
    log = logs / f"promote-{sha[:10]}-{time.strftime('%Y%m%dT%H%M%S')}.log"
    label = f"promote-{sha[:10]}"
    load_wait = wait_for_load(label)
    # Sized once the wait is over (#599 review), so jobs_decision records the load the gate starts under.
    info = host()
    decision = given_jobs(jobs, "--jobs") if jobs else gate_jobs(info)
    jobs = decision["jobs"]
    print(f"lane: batch gate: the full gate on {sha[:10]} in {path} with {jobs} jobs (log {log}); "
          "queue: slotfather status", flush=True)
    started, clock, load = now(), time.monotonic(), {"start": load_averages()}
    with open(log, "w") as handle:
        status = subprocess.run([os.path.join(path, "verify.sh"), "--keep-going", "--jobs", str(jobs)], cwd=path,
                                env=verify_env(label, "gate", sha=sha[:10]), stdout=handle,
                                stderr=subprocess.STDOUT).returncode
    seconds = round(time.monotonic() - clock, 1)
    load["end"] = load_averages()
    text = log.read_text(errors="replace")
    stamp = stamp_result(text, True) if status == 0 else {"stamped": False, "reason": "the run failed"}
    reports = re.findall(r"^Verification report: (.+)$", text, re.M)
    report = read_json(Path(reports[-1].strip())) if reports else None
    failed = [row["id"] for row in (report or {}).get("checks", [])
              if row.get("status") not in ("passed", "not_run", "skipped")]
    triaged = triage(path, Path(reports[-1].strip()).parent) if status and reports else None
    green = status == 0 and stamp["stamped"]
    module = verification_plan(path)
    write_json(state_dir() / f"{label}.gate.json", {
        "version": 1, "lane": label, "sha": sha, "tree": git(cwd, "rev-parse", sha + "^{tree}"), "full": True,
        "suites": list(getattr(module, "SUITES", ())), "jobs": jobs, "jobs_decision": decision, "exit": status,
        "seconds": seconds,
        "status": "green" if green else "red", "failed_checks": failed, "triage": triaged, "verified_tree": stamp,
        "load_wait": load_wait, "load": load,
        "results": [{"suite": "full gate", "status": "passed" if green else "failed", "seconds": seconds,
                     "load_wait": load_wait, "load": load, "log": str(log), "failed_checks": failed}],
        "log": str(log), "host": info, "started": started, "finished": now()})
    ledger(f"promote-gate {sha} {'green' if green else 'red'} jobs={jobs} seconds={seconds:.0f}"
           f"{' stamped' if stamp['stamped'] else ''} {host_fields(info)}")
    if green:
        print(f"lane: batch gate green in {seconds:.0f} s; verified tree {stamp['tree']} stamped")
        return
    if status:
        print(f"lane: batch gate red on {sha[:10]} after {seconds:.0f} s; failed checks: "
              f"{', '.join(failed) or '(see the log)'}  {log}")
        if triaged:
            print(triaged)
    else:
        print(f"lane: the batch gate passed but did not stamp: {stamp['reason']}")
    print("\n".join(bisect_lines(cwd, common, sha)))
    raise LaneError(f"promote refused: the batch gate did not stamp {sha[:10]}; nothing moved")


# The perf suite (#579, owner decision 2026-10-27): the timing budgets run only before main, once, alone on the machine.

def main_base(cwd, remote: str = "origin") -> str | None:
    """What main holds: the remote's main, else the local one."""
    return (git(cwd, "rev-parse", "--verify", "--quiet", f"refs/remotes/{remote}/main^{{commit}}", check=False)
            or git(cwd, "rev-parse", "--verify", "--quiet", "refs/heads/main^{commit}", check=False) or None)


def perf_bisect_lines(cwd, sha: str, base: str | None) -> list[str]:
    """The lane merges and other commits main has not taken: a red perf run's regression is among them."""
    if not base:
        return ["No main to bisect from: bisect the lane merges since the last release."]
    by_merge = {r["landed"]["merge"]: r["id"] for r in lanes() if r.get("landed")}
    merges, direct = [], []
    for row in git(cwd, "log", "--first-parent", "--reverse", "--format=%H %P%x1f%s", f"{base}..{sha}").splitlines():
        head, _, subject = row.partition("\x1f")
        commit, *parents = head.split()
        (merges if len(parents) > 1 else direct).append((commit, subject))
    lines = [f"Lane merges since main {base[:10]}, oldest first; bisect these for the performance regression "
             "(./verify.sh --suites perf on each):"]
    lines += [f"  {c[:10]} {s}" + (f"  lane {by_merge[c]}" if c in by_merge else "") for c, s in merges] or ["  none"]
    if direct:
        lines.append("Other commits since main:")
        lines += [f"  {c[:10]} {s}" for c, s in direct]
    return lines


def perf_suite(cwd, common: str, sha: str, ship: bool, remote: str = "origin") -> dict | None:
    """Run the perf suite on the SHA in the gate worktree: verify.sh --suites perf, which holds every verification slot
    while it measures. Returns its receipt, or None for a tree whose plan has no perf suite. For a ship, a green
    receipt of the same tree stands; a red run raises.

    One promote at a time holds the gate worktree, so the perf run never shares the machine with a batch gate."""
    plan = git(cwd, "show", f"{sha}:tools/verification_plan.py", check=False)
    suite = re.search(r"^PERF = \"([\w-]+)\"", plan or "", re.M)
    if not suite:
        print(f"lane: {sha[:10]} has no perf suite in tools/verification_plan.py; nothing to measure")
        return None
    tree = git(cwd, "rev-parse", sha + "^{tree}")
    path = state_dir() / f"perf-{sha[:10]}.perf.json"
    previous = read_json(path)
    if ship and previous and previous.get("status") == "green" and previous.get("tree") == tree:
        print(f"lane: perf suite already green on tree {tree[:10]} ({previous.get('log')})")
        return previous
    with locked("promote", f"lane: waiting for another promote's gate worktree (lock {state_dir() / '.promote.lock'})"):
        worktree = gate_worktree(common, sha)
        logs = state_dir() / "logs"
        logs.mkdir(exist_ok=True)
        log = logs / f"perf-{sha[:10]}-{time.strftime('%Y%m%dT%H%M%S')}.log"
        label = f"perf-{sha[:10]}"
        print(f"lane: perf suite on {sha[:10]} in {worktree}, alone on the machine (log {log}); "
              "queue: slotfather status", flush=True)
        started, clock, load = now(), time.monotonic(), {"start": load_averages()}
        with open(log, "w") as handle:
            status = subprocess.run([os.path.join(worktree, "verify.sh"), "--suites", suite.group(1), "--keep-going",
                                     "--jobs", "1"], cwd=worktree, env=verify_env(label, "perf", sha=sha[:10]),
                                    stdout=handle, stderr=subprocess.STDOUT).returncode
        seconds = round(time.monotonic() - clock, 1)
        load["end"] = load_averages()
        text = log.read_text(errors="replace")
        reports = re.findall(r"^Verification report: (.+)$", text, re.M)
        report = read_json(Path(reports[-1].strip())) if reports else None
        failed = [row["id"] for row in (report or {}).get("checks", []) if row.get("status") not in PASSING]
        triaged = triage(worktree, Path(reports[-1].strip()).parent) if status and reports else None
    receipt = {"version": 1, "sha": sha, "tree": tree, "status": "red" if status else "green", "exit": status,
               "seconds": seconds, "failed_checks": failed, "triage": triaged, "log": str(log), "load": load,
               "host": host(), "started": started, "finished": now()}
    write_json(path, receipt)
    ledger(f"perf {sha} {receipt['status']} seconds={seconds:.0f} {host_fields(receipt['host'])}")
    if not status:
        print(f"lane: perf suite green in {seconds:.0f} s on {sha[:10]}")
        return receipt
    print(f"lane: perf suite red on {sha[:10]} after {seconds:.0f} s; failed checks: "
          f"{', '.join(failed) or '(see the log)'}  {log}")
    if triaged:
        print(triaged)
    print("A red perf suite is a performance regression, not a flake: no registry entry excuses it.")
    print("\n".join(perf_bisect_lines(cwd, sha, main_base(cwd, remote))))
    raise LaneError(f"{'promote --ship refused' if ship else 'perf'}: the perf suite is red on {sha[:10]}; "
                    "nothing moved")


def perf(args) -> int:
    """The perf suite on a SHA by hand; it moves nothing."""
    cwd = os.getcwd()
    sha = git(cwd, "rev-parse", "--verify", "--quiet", args.sha + "^{commit}", check=False)
    if not sha:
        raise LaneError(f"perf refused: {args.sha} is not a commit here")
    perf_suite(cwd, common_dir(cwd), sha, ship=False, remote=args.remote)
    return 0


def install_and_deploy(common: str, sha: str, deploy: str | None) -> None:
    """After a promotion (#569): the Mac install from the gate worktree, check-installed, and with a host the Link
    package build and deploy, each only after the previous step succeeded. The steps run without the caller's
    STRAYLIGHT_UNPROMOTED, so each guard sees the promoted tree. The gate worktree is promote's, so the promote lock
    holds it at the SHA throughout."""
    package = state_dir() / "link-package"
    steps = [("install", ["./install-control-app.sh"], {}),
             ("check-installed", ["python3", "tools/check-installed.py", "--expect", sha], {})]
    if deploy:
        steps += [("link-package", ["tools/straylight-link/build-package.sh", str(package), "linux/amd64"], {}),
                  ("deploy", ["tools/straylight-link/deploy.sh", deploy], {"STRAYLIGHT_LINK_PACKAGE": str(package)})]
    environment = {k: v for k, v in os.environ.items() if k not in ("STRAYLIGHT_UNPROMOTED", "LANDING_TOKEN")}
    with locked("promote", f"lane: waiting for another promote's gate worktree (lock {state_dir() / '.promote.lock'})"):
        path = gate_worktree(common, sha)
        for index, (name, argv, extra) in enumerate(steps):
            print(f"lane: {name}: {' '.join(argv)} in {path}", flush=True)
            status = subprocess.run(argv, cwd=path, env={**environment, **extra}).returncode
            ledger(f"promote-{name} {sha} exit={status}")
            if status:
                skipped = ", ".join(step for step, _, _ in steps[index + 1:]) or "none"
                raise LaneError(f"promote of {sha[:10]} went through, but {name} failed (exit {status}); "
                                f"later steps not run: {skipped}")
    print(f"Installed{' and deployed' if deploy else ''} {sha[:10]}" + (f" to {deploy}" if deploy else ""))


def promote(args) -> int:
    """The batch gate on a SHA unless its tree is verified; then fast-forward local dev (and main with --ship) to
    it and push it, under the landing lock; with --install (and --deploy) install and deploy it."""
    if args.deploy and not args.install:
        raise LaneError("promote refused: --deploy needs --install (install the Mac first, as deploy.sh says)")
    if (args.install or args.deploy) and args.no_push:
        raise LaneError("promote refused: --install and --deploy need the push: the install and deploy guards take "
                        "only a SHA on origin/dev")
    status = promote_sha(args)
    if status == 0 and args.install:
        cwd = os.getcwd()
        install_and_deploy(common_dir(cwd), git(cwd, "rev-parse", args.sha + "^{commit}"), args.deploy)
    return status


# Local dev and main follow origin (#666): promote --no-push once left them ahead of it, and only the owner could
# drop the commits. sync catches them up under the landing lock; every refusal names the command that does it right.

PUBLISH_HINT = "unpushed work lives on its own branch (agent/<name>); to publish it: tools/lane promote {sha}"


def commits(count: int) -> str:
    return f"{count} commit" + ("" if count == 1 else "s")


def has_remote(cwd, remote: str) -> bool:
    return bool(git(cwd, "remote", "get-url", remote, check=False))


def fetch(cwd, remote: str, verb: str) -> None:
    fetched = subprocess.run(["git", "fetch", "-q", remote], cwd=cwd, capture_output=True, text=True)
    if fetched.returncode:
        raise LaneError(f"{verb} refused: git fetch {remote} failed: {fetched.stderr.strip()}")


def tracking(cwd, remote: str, branch: str) -> tuple[str | None, str | None]:
    """Local <branch> and <remote>/<branch>, each None when absent."""
    local = git(cwd, "rev-parse", "--verify", "--quiet", f"refs/heads/{branch}^{{commit}}", check=False) or None
    upstream = git(cwd, "rev-parse", "--verify", "--quiet", f"refs/remotes/{remote}/{branch}^{{commit}}",
                   check=False) or None
    return local, upstream


def ahead_lines(cwd, remote: str = "origin") -> list[str]:
    """A warning for each of local dev and main that has commits <remote> lacks, as last fetched."""
    lines = []
    for branch in ("dev", "main"):
        local, upstream = tracking(cwd, remote, branch)
        if local and upstream and local != upstream:
            count = int(git(cwd, "rev-list", "--count", f"{upstream}..{local}", check=False) or 0)
            if count:
                lines.append(f"local {branch} is {commits(count)} ahead of {remote}; `tools/lane sync --drop-local` "
                             "drops them with a backup")
    return lines


def no_push_refusal(cwd, sha: str, branches: list[str], remote: str) -> None:
    """--no-push moves a local branch only to what <remote> already has, so it never runs ahead of it. A repository
    without the remote has nothing to run ahead of."""
    if not has_remote(cwd, remote):
        return
    fetch(cwd, remote, "promote --no-push")
    for branch in branches:
        _, upstream = tracking(cwd, remote, branch)
        if not upstream or not git_ok(cwd, "merge-base", "--is-ancestor", sha, upstream):
            raise LaneError(f"promote --no-push refused: {sha[:10]} is not on {remote}/{branch}, and --no-push moves "
                            f"local {branch} only to what {remote} has; {PUBLISH_HINT.format(sha=sha[:10])}")


def backup_name(cwd, branch: str) -> str:
    """backup/<branch>-<date>, or -<date>-N for the next free N."""
    base = f"backup/{branch}-{datetime.date.today().isoformat()}"
    name, number = base, 1
    while git_ok(cwd, "rev-parse", "--verify", "--quiet", f"refs/heads/{name}"):
        number += 1
        name = f"{base}-{number}"
    return name


def sync(args) -> int:
    """Fetch, then fast-forward local dev and main to <remote> under the landing lock; with --drop-local reset them to
    it, keeping the commits <remote> lacks on a backup branch first. A refusal moves neither branch."""
    cwd = os.getcwd()
    common = common_dir(cwd)
    verb = "sync --drop-local" if args.drop_local else "sync"
    if not has_remote(cwd, args.remote):
        raise LaneError(f"{verb} refused: no remote {args.remote} here; nothing moved")
    fetch(cwd, args.remote, verb)
    checked_out = {w["branch"]: w["path"] for w in worktree_list(cwd) if w.get("branch")}
    moves, notes, diverged = [], [], []
    for branch in ("dev", "main"):
        local, upstream = tracking(cwd, args.remote, branch)
        if not local or not upstream:
            missing = f"local {branch}" if not local else f"{args.remote}/{branch}"
            notes.append(f"{branch}: no {missing}; left alone")
        elif local == upstream:
            notes.append(f"{branch}: up to date at {local[:10]}")
        elif git_ok(cwd, "merge-base", "--is-ancestor", local, upstream):
            moves.append((branch, local, upstream, None))
        else:
            dropped = git(cwd, "log", "--oneline", "--no-decorate", f"{upstream}..{local}").splitlines()
            diverged.append((branch, local, upstream, dropped))
    if diverged and not args.drop_local:
        lines = []
        for branch, _, _, dropped in diverged:
            verb_form = "is" if len(dropped) == 1 else "are"
            lines.append(f"local {branch} has {commits(len(dropped))} that {verb_form} not on {args.remote}/{branch}:")
            lines += [f"  {line}" for line in dropped]
        raise LaneError("sync refused: " + "\n".join(lines) + "\nWork to keep goes on its own branch (git branch "
                        "agent/<name> <commit>) and lands through a lane; to publish a landed SHA: tools/lane promote "
                        f"<sha>. If they are stale: tools/lane sync --drop-local resets to {args.remote} and keeps "
                        "them on a backup branch; nothing moved")
    for branch, _, _, _ in diverged:
        if branch in checked_out:
            dirty = git(checked_out[branch], "status", "--porcelain", "--untracked-files=no")
            if dirty:
                raise LaneError(f"{verb} refused: {checked_out[branch]} has {branch} checked out with uncommitted "
                                f"changes:\n{dirty}\nCommit them on their own branch or move them away; nothing moved")
    moves += diverged
    if not moves:
        print(f"lane: local dev and main are up to date with {args.remote} ({'; '.join(notes)})")
        return 0
    holder = f"tools/lane {verb} (pid {os.getpid()}, {cwd})"
    done, failed = [], []
    with landing(common, holder, args.wait) as env:
        for branch, old, new, dropped in moves:
            where = checked_out.get(branch)
            backup = None
            if dropped is not None:
                backup = backup_name(cwd, branch)
                git(cwd, "branch", backup, old)
                print(f"lane: {backup} keeps the {commits(len(dropped))} dropped from local {branch}:")
                for line in dropped:
                    print(f"  {line}")
                # reset --keep refuses to overwrite local changes, as a checked-out branch's worktree may have.
                argv = (["git", "reset", "-q", "--keep", new] if where else
                        ["git", "update-ref", "-m", f"lane sync --drop-local ({backup})", f"refs/heads/{branch}", new,
                         old])
            else:
                argv = (["git", "merge", "--ff-only", "-q", new] if where else
                        ["git", "update-ref", "-m", "lane sync", f"refs/heads/{branch}", new, old])
            moved = subprocess.run(argv, cwd=where or cwd, env=env, capture_output=True, text=True)
            if moved.returncode:
                failed.append(f"local {branch} in {where or cwd}: {(moved.stdout + moved.stderr).strip()}")
            elif backup:
                done.append(f"{branch} {old[:10]}->{new[:10]}, {commits(len(dropped))} dropped, kept on {backup}")
            else:
                done.append(f"{branch} {old[:10]}->{new[:10]} fast-forwarded")
    ledger(f"sync {args.remote}: {'; '.join(done) or '-'}" + (f" failed: {'; '.join(failed)}" if failed else ""))
    for line in done + notes:
        print(f"lane: {line}")
    if failed:
        print("lane: these local branches did not move:\n  " + "\n  ".join(failed), file=sys.stderr)
        return 1
    return 0


def adopt_ui_libs(cwd: str, sha: str) -> None:
    """After dev moved: the one check of tools/ui-libs.py (#588), which queues a pin lane for a newer compatible
    Sid-Kit and Data Grid pair and prints one line. It never fails the promote; a tree without the vendored pins
    (Sid-Kit and Data Grid promote with this too) prints nothing."""
    try:
        loader = importlib.machinery.SourceFileLoader("straylight_ui_libs", str(Path(__file__).with_name("ui-libs.py")))
        spec = importlib.util.spec_from_loader(loader.name, loader)
        module = importlib.util.module_from_spec(spec)
        loader.exec_module(module)
        module.check(cwd, sha, f"promote {sha[:10]}", lane=sys.modules.get(__name__))
    except Exception as error:  # the promote went through; the adoption check only warns
        print(f"ui-libs: warning: the check failed: {error}", file=sys.stderr)


def promote_sha(args) -> int:
    cwd = os.getcwd()
    common = common_dir(cwd)
    sha = git(cwd, "rev-parse", "--verify", "--quiet", args.sha + "^{commit}", check=False)
    if not sha:
        raise LaneError(f"promote refused: {args.sha} is not a commit here")
    if args.no_push:
        no_push_refusal(cwd, sha, ["dev", "main"] if args.ship else ["dev"], args.remote)
    for line in ahead_lines(cwd, args.remote):
        print(f"lane: {line}", flush=True)
    # main takes only released notes: fragments wait on dev until a release commit folds them (#447).
    if args.ship and git(cwd, "ls-tree", "--name-only", f"{sha}:release-notes/unreleased", check=False):
        raise LaneError(f"promote --ship refused: {sha[:10]} still has release-notes/unreleased/; run node "
                        f"tools/release-notes.mjs release, commit, and ship that commit")
    # Only fully gated trees are promoted. Repositories without the stamp tooling have their own pre-push gate.
    if git_ok(cwd, "cat-file", "-e", f"{sha}:verify.sh") and git_ok(cwd, "cat-file", "-e",
                                                                     f"{sha}:tools/verified-tree.sh"):
        if verified(cwd, common, sha):
            print(f"lane: {sha[:10]}'s tree is already verified; no batch gate needed")
        else:
            batch_gate(cwd, common, sha, args.jobs)
    # The gate runs while reviews finish; only the move of dev waits for them (#570).
    refusals = review_refusals(cwd, common, sha)
    if refusals and not args.force_reason:
        raise LaneError(f"promote refused: dev waits for the review of every lane landed since dev:\n- "
                        + "\n- ".join(refusals) + "\nMark each finding with " + MARK_HELP.format(id="<id>")
                        + f", then rerun tools/lane promote {sha[:10]}; a stamped tree is not gated again. "
                        "--force-reason overrides, logged")
    if refusals:
        ledger(f"override promote {sha}: {args.force_reason} ({'; '.join(refusals)})")
    # main takes only a tree whose timing budgets held, measured alone after the gate (#579); dev never waits for it.
    if args.ship and git_ok(cwd, "cat-file", "-e", f"{sha}:verify.sh"):
        perf_suite(cwd, common, sha, ship=True, remote=args.remote)
    branches = ["dev", "main"] if args.ship else ["dev"]
    subject = git(cwd, "log", "-1", "--format=%s", sha)
    holder = f"tools/lane promote {sha[:10]}{' --ship' if args.ship else ''} (pid {os.getpid()}, {cwd})"
    ship_base = None
    with landing(common, holder, args.wait) as env:
        if not args.no_push:
            fetch(cwd, args.remote, "promote")
        if args.ship:
            # The overall review covers what main gains: origin/main (local main without one) to the SHA.
            ship_base = (git(cwd, "rev-parse", "--verify", "--quiet", f"refs/remotes/{args.remote}/main^{{commit}}",
                             check=False)
                         or git(cwd, "rev-parse", "--verify", "--quiet", "refs/heads/main^{commit}", check=False))
        moves = []
        for branch in branches:
            old = git(cwd, "rev-parse", "--verify", "--quiet", f"refs/heads/{branch}^{{commit}}", check=False)
            if old and not git_ok(cwd, "merge-base", "--is-ancestor", old, sha):
                foreign = git(cwd, "log", "--oneline", "--no-decorate", "-10", f"{sha}..{old}")
                raise LaneError(f"promote refused: local {branch} has commits that are not in {sha[:10]}:\n{foreign}\n"
                                f"Land them through a lane into the integration branch; if they are stale, "
                                f"tools/lane sync --drop-local drops them and keeps them on a backup branch. "
                                f"Nothing was pushed")
            moves.append((branch, old))
        if not args.no_push:
            refspecs = [f"{sha}:refs/heads/{branch}" for branch in branches]
            print(f"lane: pushing {sha[:10]} {subject!r} to {args.remote} {' and '.join(branches)}", flush=True)
            # The pre-push hook gates the push: a verified tree, and main only as a dev tip. The push moves
            # remote-tracking refs only, so the token stays out of the verify runs a pre-push hook may start.
            # --atomic: the remote takes dev and main together or neither, so a refused main leaves dev in place.
            if subprocess.run(["git", "push", "--atomic", args.remote, *refspecs], cwd=cwd).returncode:
                raise LaneError(f"promote refused: git push {args.remote} {' '.join(refspecs)} failed; "
                                f"local {' and '.join(branches)} unchanged")
        checked_out = {w["branch"]: w["path"] for w in worktree_list(cwd) if w.get("branch")}
        failed = []
        for branch, old in moves:
            if old == sha:
                continue
            if branch in checked_out:
                argv, where = ["git", "merge", "--ff-only", "-q", sha], checked_out[branch]
            else:
                argv, where = ["git", "update-ref", "-m", f"lane promote {sha[:10]}", f"refs/heads/{branch}", sha,
                               old or ""], cwd
            moved = subprocess.run(argv, cwd=where, env=env, capture_output=True, text=True)
            if moved.returncode:
                failed.append(f"local {branch} in {where}: {(moved.stdout + moved.stderr).strip()}")
    pushed = "local only" if args.no_push else f"pushed to {args.remote}"
    ledger(f"promote {sha} {'+'.join(branches)} {pushed}" + (f" failed: {'; '.join(failed)}" if failed else ""))
    if failed:
        print("lane: " + ("the push went through, but " if not args.no_push else "") + "these local branches did "
              f"not move:\n  " + "\n  ".join(failed) + f"\nFix that, then rerun tools/lane promote {sha[:10]}"
              + (" --ship" if args.ship else ""), file=sys.stderr)
        return 1
    print(f"Promoted {sha[:10]} {subject!r}: {' and '.join(branches)}, {pushed}")
    adopt_ui_libs(cwd, sha)
    if args.ship and ship_base:
        print(f"lane: {start_overall_review(cwd, sha, ship_base)}")
    return 0


# Independent review (#570): one review per lane beside its land, gating the move of dev; one overall review on
# promote --ship. Owner decisions 2026-10-27: Sol 6.1 at medium effort while Codex has at least 15% of its weekly
# limit left, else Opus 5.5 at medium effort; exactly one review and one fix round per lane.

SOL_MODEL, OPUS_MODEL, REVIEW_EFFORT = "gpt-6.1-sol", "claude-opus-5-5", "medium"
SOL_MIN_LEFT = 15
WEEK_MINUTES = 10080
LIMIT_TIMEOUT = 20
REVIEW_TIMEOUT = 30 * 60
OPUS_TOOLS = "Read,Grep,Glob,Bash(git diff:*),Bash(git log:*),Bash(git show:*)"
MAX_INLINE_DIFF = 400_000
MAX_FINDINGS = 8
SEVERITIES = ("P1", "P2", "P3")
MARK_HELP = "tools/lane review {id} --mark <n> fixed:<merge>|rejected:<reason>"


class ReviewFailed(Exception):
    pass


def gh_command() -> str:
    return os.environ.get("STRAYLIGHT_LANE_GH") or "gh"


def repo_args(common: str) -> list[str]:
    """`-R owner/name` for gh, from the origin remote; [] when origin is not on GitHub."""
    origin = git(main_checkout(common), "remote", "get-url", "origin", check=False)
    found = re.search(r"github\.com[:/]([^/]+/[^/.]+)", origin)
    return ["-R", found.group(1)] if found else []


def configured_codex() -> str | None:
    """CODEX_CLI_PATH from the Codex config ($CODEX_HOME/config.toml), wherever the ChatGPT app put it."""
    try:
        import tomllib  # Python 3.11+, as in read_queue
        path = Path(os.path.expanduser(os.environ.get("CODEX_HOME") or "~/.codex")) / "config.toml"
        stack = [tomllib.loads(path.read_text())]
    except Exception:
        return None
    while stack:
        table = stack.pop()
        if isinstance(table.get("CODEX_CLI_PATH"), str):
            return table["CODEX_CLI_PATH"]
        stack += [value for value in table.values() if isinstance(value, dict)]
    return None


def codex_cli() -> str | None:
    """The Codex CLI the review runs: STRAYLIGHT_LANE_CODEX; else CODEX_CLI_PATH from the environment or the Codex
    config, as the ChatGPT app sets it; else codex on PATH. The npm codex 0.147.0 rejects gpt-6.1-sol, the app's
    CLI runs it; a CLI that cannot run the model fails its run, and Opus reviews."""
    explicit = os.environ.get("STRAYLIGHT_LANE_CODEX")
    if explicit is not None:
        return explicit if explicit and os.access(explicit, os.X_OK) else None
    for candidate in (os.environ.get("CODEX_CLI_PATH"), configured_codex()):
        if candidate and os.access(candidate, os.X_OK):
            return candidate
    return shutil.which("codex")


def codex_limit(codex: str) -> dict:
    """The live weekly Codex limit, from `codex app-server` (initialize, initialized, account/rateLimits/read):
    {"left": percent or None, "blocked": why Sol may not run or None}."""
    import threading
    try:
        child = subprocess.Popen([codex, "app-server"], stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                 stderr=subprocess.DEVNULL, text=True)
    except OSError as error:
        return {"left": None, "blocked": f"codex app-server did not start: {error}"}
    answer: dict = {}

    def read():
        for line in child.stdout:
            try:
                message = json.loads(line)
            except ValueError:
                continue
            if isinstance(message, dict) and message.get("id") == 2:
                answer.update(message)
                return
    reader = threading.Thread(target=read, daemon=True)
    reader.start()
    try:
        for message in ({"id": 1, "method": "initialize",
                         "params": {"clientInfo": {"name": "tools-lane-review", "version": "1"}}},
                        {"method": "initialized"}, {"id": 2, "method": "account/rateLimits/read"}):
            child.stdin.write(json.dumps(message) + "\n")
        child.stdin.flush()
        reader.join(LIMIT_TIMEOUT)
    except OSError:
        pass
    finally:
        child.kill()
        child.wait()
    if not answer:
        return {"left": None, "blocked": f"codex app-server gave no rate limits within {LIMIT_TIMEOUT} s"}
    if answer.get("error"):
        return {"left": None, "blocked": f"codex app-server: {answer['error'].get('message', answer['error'])}"}
    limits = (answer.get("result") or {}).get("rateLimits") or {}
    windows = [w for w in (limits.get("primary"), limits.get("secondary")) if isinstance(w, dict)]
    weekly = next((w for w in windows if w.get("windowDurationMins") == WEEK_MINUTES), windows[0] if windows else {})
    used = weekly.get("usedPercent")
    left = int(100 - used) if isinstance(used, (int, float)) else None
    blocked = (f"Codex reports {limits['rateLimitReachedType']}" if limits.get("rateLimitReachedType")
               else "Codex spend control is reached" if limits.get("spendControlReached")
               else "the Codex limit could not be read" if left is None else None)
    return {"left": left, "blocked": blocked, "rate_limits": limits}


def claude_cli() -> str | None:
    return os.environ.get("STRAYLIGHT_LANE_CLAUDE") or shutil.which("claude")


def alive(pid) -> bool:
    if not isinstance(pid, int) or pid <= 0:
        return False
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


def review_state(label: str) -> tuple[bool, str]:
    """Whether the review lets promote move dev, and its state in words."""
    receipt = read_json(receipt_path(label, "review"))
    if receipt is None:
        return False, f"no review: run tools/lane review {label}"
    status = receipt.get("status")
    if status == "exempt":
        return True, f"review exempt: {receipt.get('exempt')}"
    if status == "running":
        if alive(receipt.get("pid")):
            return False, f"review running since {receipt.get('started')} (pid {receipt.get('pid')}, {receipt.get('log')})"
        return False, f"review died (pid {receipt.get('pid')}, {receipt.get('log')}): rerun tools/lane review {label}"
    if status != "finished":
        return False, f"review failed: {receipt.get('error')}; rerun tools/lane review {label}"
    findings = receipt.get("findings", [])
    unmarked = [f for f in findings if not f.get("mark")]
    if unmarked:
        return False, (f"{len(unmarked)} of {len(findings)} review findings unmarked "
                       f"({', '.join('#' + str(f['n']) for f in unmarked)})")
    return True, f"reviewed by {receipt.get('reviewer')}: {len(findings)} findings, all marked"


# What steers agents and the reviewer is reviewed even when it is Markdown.
STEERING = (".agents/**", ".claude/**", "CODING_STANDARDS.md", "**/AGENTS.md", "**/CLAUDE.md",
            "tools/agent-hooks/rules/**")


def documentation_only(paths: list[str]) -> bool:
    """Whether a merge changes only documentation, *.md and docs/**, and none of the steering files."""
    return all((p.endswith(".md") or p.startswith("docs/")) and not any(matches(s, p) for s in STEERING)
               for p in paths)


def review_exemption(record: dict) -> str | None:
    if record.get("review_fix_of"):
        return f"the fix round of {record['review_fix_of']}'s review, which nobody reviews again"
    if (record.get("landed") or {}).get("docs_only"):
        return "documentation only: it changes only *.md and docs/** outside the steering files"
    return None


def review_range(record: dict) -> tuple[str, str]:
    """The lane's tip and the base to diff it against: the last integration commit the lane merged, never the
    integration branch, which already holds the landed lane."""
    main = main_checkout(record["common_dir"])
    landed = record.get("landed")
    if landed:
        tip, against = landed["tip"], landed["previous"]
    else:
        tip = git(main, "rev-parse", "--verify", record["branch"] + "^{commit}")
        against = git(main, "rev-parse", "--verify", "--quiet", record["base"] + "^{commit}",
                      check=False) or record["base_sha"]
    return tip, git(main, "merge-base", against, tip)


def coding_standards(main: str, tip: str) -> str:
    """CODING_STANDARDS.md of the reviewed tree, else of this tool's checkout (Sid-Kit and Data Grid have none)."""
    shown = subprocess.run(["git", "show", f"{tip}:CODING_STANDARDS.md"], cwd=main, capture_output=True, text=True)
    if shown.returncode == 0:
        return shown.stdout.strip()
    try:
        return (Path(__file__).resolve().parent.parent / "CODING_STANDARDS.md").read_text().strip()
    except OSError:
        return "(no CODING_STANDARDS.md)"


def ticket_text(record: dict) -> str:
    if record["ticket"] == "none":
        return "The lane has no ticket."
    result = subprocess.run([gh_command(), "issue", "view", record["ticket"], "--json", "title,body",
                             *repo_args(record["common_dir"])], capture_output=True, text=True)
    try:
        data = json.loads(result.stdout) if result.returncode == 0 else None
    except ValueError:
        data = None
    if not isinstance(data, dict):
        return f"Ticket #{record['ticket']} (gh could not read it: {result.stderr.strip()[:300]})"
    return f"Ticket #{record['ticket']}: {data.get('title', '')}\n\n{data.get('body', '')}".strip()


def review_prompt(standards: str, subject: str, base: str, tip: str, diff: str | None) -> str:
    """The reviewer gets the diff, the ticket and the coding standards; never the lane's report."""
    lines = [
        "You review one change to the Straylight repository before it reaches the owner's Mac. Report correctness",
        "bugs and breaks of the coding standards below; no style nits and no praise.",
        "",
        "## Coding standards (CODING_STANDARDS.md)",
        "",
        standards,
        "",
        "## What the change is for",
        "",
        subject,
        "",
        "## The change",
        "",
        f"The change is `git diff {base}...{tip}` in this checkout (HEAD is {tip}). Read it and the code around it;",
        "do not modify files.",
    ]
    if diff is not None:
        lines += ["", "```diff", diff.rstrip("\n"), "```"]
    lines += [
        "",
        "## Answer",
        "",
        f"List at most {MAX_FINDINGS} findings, most severe first: P1 a bug, P2 a risk, P3 minor. For each give",
        "file:line, the concrete failure scenario and the fix. End the answer with one fenced json block that holds",
        "the same findings in the same order:",
        "",
        "```json",
        '{"findings": [{"severity": "P1", "file": "path/in/repo", "line": 123, "title": "one line",',
        '               "detail": "the failure scenario and the fix"}]}',
        "```",
        "",
        'With nothing to report, end with {"findings": []}.',
    ]
    return "\n".join(lines) + "\n"


def parse_findings(text: str) -> list[dict]:
    """The findings of the last json block that has them. An answer without one is a single finding to read, so
    an unreadable review never passes as clean."""
    for block in reversed(re.findall(r"```json[ \t]*\n(.*?)```", text, re.S)):
        try:
            data = json.loads(block)
        except ValueError:
            continue
        items = data.get("findings") if isinstance(data, dict) else None
        if isinstance(items, list) and not all(isinstance(i, dict) for i in items):
            return unreadable_answer(text)
        if isinstance(items, list):
            found = []
            for item in items:
                severity = str(item.get("severity", "")).upper()
                line = item.get("line")
                found.append({"n": len(found) + 1, "severity": severity if severity in SEVERITIES else "P2",
                              "file": item.get("file") if isinstance(item.get("file"), str) else None,
                              "line": line if isinstance(line, int) else None,
                              "title": str(item.get("title") or "").strip()[:300],
                              "detail": str(item.get("detail") or "").strip()[:4000], "mark": None})
            return found
    if re.search(r"\bno findings\b", text, re.I) and len(text) < 400:
        return []
    return unreadable_answer(text)


def unreadable_answer(text: str) -> list[dict]:
    return [{"n": 1, "severity": "P2", "file": None, "line": None, "mark": None,
             "title": "the review answer has no readable findings block: read it and mark it",
             "detail": text.strip()[:4000]}]


def run_reviewer(argv, cwd, prompt: str, stdout: Path, log: Path) -> int:
    """Run one reviewer with the prompt on stdin; its exit, 124 on the timeout. Stopping this process stops it."""
    with open(stdout, "w") as out, open(log, "a") as err:
        child = subprocess.Popen(argv, cwd=cwd, stdin=subprocess.PIPE, stdout=out,
                                 stderr=err if stdout != log else subprocess.STDOUT, text=True)
        try:
            child.communicate(prompt, timeout=REVIEW_TIMEOUT)
        except subprocess.TimeoutExpired:
            child.kill()
            child.wait()
            return 124
        except BaseException:
            child.terminate()
            try:
                child.wait(timeout=30)
            except subprocess.TimeoutExpired:
                child.kill()
                child.wait()
            raise
    return child.returncode


def last_lines(path: Path, count: int = 3) -> str:
    try:
        lines = [line for line in path.read_text(errors="replace").splitlines() if line.strip()]
    except OSError:
        return ""
    return " / ".join(lines[-count:])[:500]


@contextlib.contextmanager
def review_checkout(main: str, label: str, tip: str):
    """A worktree detached at the reviewed tip, removed on every exit path, so landing and done go on meanwhile."""
    root = state_dir() / "reviews"
    root.mkdir(exist_ok=True)
    for stale in root.glob(f"{label}-checkout-*"):
        remove_checkout(main, stale)
    path = root / f"{label}-checkout-{os.getpid()}"
    try:
        git(main, "worktree", "add", "-q", "--detach", str(path), tip)
        yield str(path)
    finally:
        remove_checkout(main, path)


def perform_review(label: str, fields: dict, main: str, base: str, tip: str, subject: str, finalize=None) -> dict:
    """Review base...tip with Sol, or Opus when Sol may not or cannot run; write and return the receipt.
    `finalize` completes a finished receipt before anyone can read it as finished."""
    path = receipt_path(label, "review")
    receipt = {"version": 1, "label": label, **fields, "base": base, "tip": tip,
               "tree": git(main, "rev-parse", tip + "^{tree}"), "status": "running", "pid": os.getpid(),
               "log": os.environ.get("STRAYLIGHT_LANE_REVIEW_LOG"), "started": now(), "effort": REVIEW_EFFORT}
    with locked(f"review-{label}"):
        write_json(path, receipt)
    reviews = state_dir() / "reviews"
    reviews.mkdir(exist_ok=True)
    output, log = reviews / f"{label}.md", reviews / f"{label}.log"
    log.write_text("")
    clock = time.monotonic()
    try:
        with terminable(), review_checkout(main, label, tip) as checkout:
            standards = coding_standards(main, tip)
            codex = codex_cli()
            limit = codex_limit(codex) if codex else {"left": None, "blocked": None}
            receipt.update(codex=codex, codex_left=limit["left"])
            fallback = ("no Codex CLI (STRAYLIGHT_LANE_CODEX, CODEX_CLI_PATH, codex on PATH)" if not codex
                        else limit["blocked"] or (f"Codex has {limit['left']}% of the weekly limit left, under "
                                                  f"{SOL_MIN_LEFT}%" if limit["left"] < SOL_MIN_LEFT else None))
            text = ""
            if fallback is None:
                receipt.update(reviewer="sol", model=SOL_MODEL)
                print(f"lane: review {label}: {SOL_MODEL} {REVIEW_EFFORT} ({limit['left']}% of the weekly Codex "
                      f"limit left) on {base[:10]}...{tip[:10]}", flush=True)
                # A stale answer of an earlier run must never stand in for this one's.
                output.unlink(missing_ok=True)
                status = run_reviewer([codex, "exec", "-C", checkout, "-s", "read-only", "-m", SOL_MODEL, "-c",
                                       f'model_reasoning_effort="{REVIEW_EFFORT}"', "--ephemeral", "-o", str(output),
                                       "-"], checkout, review_prompt(standards, subject, base, tip, None), log, log)
                text = output.read_text(errors="replace") if output.exists() else ""
                # A model error, a limit hit mid-run or an empty answer: Sol is unavailable, Opus reviews once.
                if status or not text.strip():
                    fallback = (f"the Sol run failed (exit {status}): {last_lines(log)}" if status
                                else "Sol returned an empty review")
            if fallback is not None:
                receipt.update(reviewer="opus", model=OPUS_MODEL, fallback=fallback)
                print(f"lane: review {label}: {OPUS_MODEL} {REVIEW_EFFORT} ({fallback})", flush=True)
                claude = claude_cli()
                if not claude:
                    raise ReviewFailed("no claude CLI on PATH (STRAYLIGHT_LANE_CLAUDE)")
                diff = git(checkout, "diff", f"{base}...{tip}")
                if len(diff) > MAX_INLINE_DIFF:
                    diff = diff[:MAX_INLINE_DIFF] + "\n[diff truncated: read the rest with git diff]"
                output.unlink(missing_ok=True)
                status = run_reviewer([claude, "-p", "--model", OPUS_MODEL, "--effort", REVIEW_EFFORT,
                                       "--allowedTools", OPUS_TOOLS], checkout,
                                      review_prompt(standards, subject, base, tip, diff), output, log)
                text = output.read_text(errors="replace") if output.exists() else ""
                if status or not text.strip():
                    raise ReviewFailed(f"the Opus run failed (exit {status}): {last_lines(log)}"
                                       if status else "Opus returned an empty review")
        receipt.update(status="finished", findings=parse_findings(text), output=str(output))
        if finalize:
            finalize(receipt)
    except Exception as error:  # any failure leaves a failed receipt, not a running one
        receipt.update(status="failed", error=str(error), output=str(output))
    receipt.setdefault("fallback", None)
    receipt.update(seconds=round(time.monotonic() - clock, 1), finished=now())
    with locked(f"review-{label}"):
        write_json(path, receipt)
    findings = receipt.get("findings", [])
    counts = " ".join(f"{s.lower()}={sum(1 for f in findings if f['severity'] == s)}" for s in SEVERITIES)
    ledger(f"review {label} {receipt['status']} reviewer={receipt.get('reviewer', '-')} model={receipt.get('model', '-')} "
           f"effort={REVIEW_EFFORT} left={'-' if receipt.get('codex_left') is None else receipt['codex_left']} "
           f"seconds={receipt['seconds']:.0f} findings={len(findings)} {counts}"
           + (f" fallback: {receipt['fallback']}" if receipt["fallback"] else ""))
    return receipt


def review_lines(receipt: dict) -> list[str]:
    label = receipt["label"]
    if receipt["status"] == "exempt":
        return [f"Review of {label}: exempt ({receipt['exempt']})"]
    if receipt["status"] == "running":
        return [f"Review of {label}: running since {receipt.get('started')} (pid {receipt.get('pid')}, log "
                f"{receipt.get('log')})"]
    left = receipt.get("codex_left")
    head = (f"Review of {label} ({receipt.get('base', '')[:10]}...{receipt.get('tip', '')[:10]}) by "
            f"{receipt.get('model')} {receipt.get('effort')}"
            + (f", {left}% of the weekly Codex limit left" if left is not None else "")
            + (f"; fallback: {receipt['fallback']}" if receipt.get("fallback") else "")
            + f", {receipt.get('seconds', 0):.0f} s")
    if receipt["status"] != "finished":
        return [head, f"review failed: {receipt.get('error')}"]
    findings = receipt.get("findings", [])
    lines = [head + f": {len(findings)} findings  ({receipt.get('output')})"]
    for f in findings:
        where = f"{f['file']}:{f['line']}" if f.get("file") and f.get("line") else f.get("file") or "-"
        mark = f.get("mark")
        state = ("" if not mark else f"  [fixed: {mark['merge'][:10]}]" if mark["kind"] == "fixed"
                 else f"  [rejected: {mark['reason']}]")
        lines.append(f"  {f['n']}. {f['severity']} {where} {f['title']}{state}")
        lines += [f"     {line}" for line in f.get("detail", "").splitlines()[:6]]
    if receipt.get("issue"):
        lines.append(f"Ticket: {receipt['issue']}")
    elif receipt.get("issue_error"):
        lines.append(f"Ticket not filed: {receipt['issue_error']}; tools/lane review --overall "
                     f"{receipt.get('tip', '')[:10]} files it again")
    if receipt.get("kind") == "lane" and any(not f.get("mark") for f in findings):
        lines.append("Mark each finding: " + MARK_HELP.format(id=label) + "; the fix round runs in the lane's "
                     f"worktree on a follow-up lane: tools/lane review {label} --fix-lane")
    return lines


def review_start_manual() -> bool:
    return os.environ.get("STRAYLIGHT_LANE_REVIEW_START") == "manual"


def spawn_review(label: str, fields: dict, argv: list[str], cwd: str) -> dict:
    """Start `tools/lane review ...` detached, with its own log, and record it as running; nobody waits for it."""
    logs = state_dir() / "logs"
    logs.mkdir(exist_ok=True)
    log = logs / f"review-{label}-{time.strftime('%Y%m%dT%H%M%S')}.log"
    # The child writes its own receipt under the same lock, so this running one never replaces a finished one.
    with locked(f"review-{label}"), open(log, "w") as out:
        child = subprocess.Popen([sys.executable, os.path.realpath(__file__), "review", *argv], cwd=cwd,
                                 stdin=subprocess.DEVNULL, stdout=out, stderr=subprocess.STDOUT,
                                 start_new_session=True, env=dict(os.environ, STRAYLIGHT_LANE_REVIEW_LOG=str(log)))
        receipt = {"version": 1, "label": label, **fields, "status": "running", "pid": child.pid, "log": str(log),
                   "started": now(), "effort": REVIEW_EFFORT}
        write_json(receipt_path(label, "review"), receipt)
    ledger(f"review-start {label} pid={child.pid} log={log}")
    return receipt


def start_lane_review(record: dict) -> str:
    """At land: an exempt receipt, or the review in the background. The line land prints."""
    lane_id = record["id"]
    current = read_json(receipt_path(lane_id, "review")) or {}
    if current.get("status") in ("finished", "exempt") or (current.get("status") == "running"
                                                          and alive(current.get("pid"))):
        # Reviewed before landing (onto dev or main), or by hand: one review per lane, kept as it is.
        ledger(f"review {lane_id} kept at land: {current['status']} since {current.get('started') or current.get('finished')}")
        return f"review kept: {review_state(lane_id)[1]}"
    exempt = review_exemption(record)
    if exempt:
        write_json(receipt_path(lane_id, "review"), {"version": 1, "label": lane_id, "kind": "lane",
                                                     "lane": lane_id, "ticket": record["ticket"], "status": "exempt",
                                                     "exempt": exempt, "finished": now()})
        ledger(f"review {lane_id} exempt: {exempt}")
        return f"review exempt: {exempt}"
    if review_start_manual():
        return f"review not started (STRAYLIGHT_LANE_REVIEW_START=manual): run tools/lane review {lane_id}"
    receipt = spawn_review(lane_id, {"kind": "lane", "lane": lane_id, "ticket": record["ticket"]}, [lane_id],
                           main_checkout(record["common_dir"]))
    return f"review started in the background (pid {receipt['pid']}, log {receipt['log']})"


def review_complete_finish(lane_id: str) -> None:
    """After the lane's review is clean or fully marked: finish the lane as land would have, unless land is still
    running its smoke (land finishes it then), kept it (--keep), or its smoke was red."""
    record = load(lane_id)
    if record["status"] not in ("landed", "released"):
        return
    if (record.get("landed") or {}).get("keep"):
        print(f"Lane {lane_id} kept (--keep): finish it with tools/lane done {lane_id}")
        return
    if (record.get("post_merge") or {}).get("status") != "green":
        return
    finish_landed(lane_id, False)


def review_lane(args) -> int:
    record = load(args.id)
    current = read_json(receipt_path(args.id, "review")) or {}
    status, pid = current.get("status"), current.get("pid")
    # The background run land started finds its own pid in the receipt.
    elsewhere = status == "running" and alive(pid) and pid != os.getpid()
    if (status in ("finished", "exempt") or elsewhere) and not args.force_reason:
        print("\n".join(review_lines(current)))
        if status == "finished":
            print(f"Lane {args.id} is already reviewed: one review per lane (--force-reason reviews again, logged)")
        return 0
    if status == "finished":
        ledger(f"override review {args.id}: {args.force_reason} (reviewed again)")
    exempt = review_exemption(record)
    if exempt and not args.force_reason:
        start_lane_review(record)
        print(f"Review of {args.id}: exempt ({exempt})")
        return 0
    tip, base = review_range(record)
    receipt = perform_review(args.id, {"kind": "lane", "lane": args.id, "ticket": record["ticket"]},
                             main_checkout(record["common_dir"]), base, tip, ticket_text(record))
    print("\n".join(review_lines(receipt)))
    if receipt["status"] != "finished":
        return 1
    if review_state(args.id)[0]:
        review_complete_finish(args.id)
    return 0


def fix_merge(common: str, value: str) -> str:
    """The commit a `fixed:` mark names: a landed lane's merge (the fix lane's id) or a commit."""
    record = read_json(record_path(value)) if ID.match(value) else None
    if record and (record.get("landed") or {}).get("merge"):
        return record["landed"]["merge"]
    sha = git(main_checkout(common), "rev-parse", "--verify", "--quiet", value + "^{commit}", check=False)
    if not value or not sha:
        raise LaneError(f"fixed:{value}: not a commit or a landed lane here; give the follow-up merge")
    return sha


def mark_review(args) -> int:
    record = load(args.id)
    path = receipt_path(args.id, "review")
    with locked(f"review-{args.id}"):
        receipt = read_json(path)
        if not receipt or receipt.get("status") != "finished":
            raise LaneError(f"lane {args.id} has no finished review to mark ({review_state(args.id)[1]})")
        by_number = {f["n"]: f for f in receipt.get("findings", [])}
        marks = []
        for number, value in args.mark:
            finding = by_number.get(int(number)) if number.isdigit() else None
            if finding is None:
                raise LaneError(f"--mark {number}: the review of {args.id} has findings "
                                f"{', '.join(str(n) for n in by_number) or 'none'}")
            kind, _, detail = value.partition(":")
            detail = detail.strip()
            if kind == "fixed":
                marks.append((finding, {"kind": "fixed", "merge": fix_merge(record["common_dir"], detail),
                                        "at": now()}))
            elif kind == "rejected":
                if not detail:
                    raise LaneError(f"--mark {number} rejected: give the reason, rejected:<reason>")
                marks.append((finding, {"kind": "rejected", "reason": detail, "at": now()}))
            else:
                raise LaneError(f"--mark {number} {value}: use fixed:<merge> or rejected:<reason>")
        for finding, mark in marks:
            finding["mark"] = mark
            ledger(f"review-mark {args.id} {finding['n']} " + (f"fixed:{mark['merge'][:10]}" if mark["kind"] == "fixed"
                                                                else f"rejected: {mark['reason']}"))
        write_json(path, receipt)
    print("\n".join(review_lines(receipt)))
    complete, state = review_state(args.id)
    if complete:
        kinds = [f["mark"]["kind"] for f in receipt.get("findings", [])]
        ledger(f"review-marked {args.id} fixed={kinds.count('fixed')} rejected={kinds.count('rejected')}")
        review_complete_finish(args.id)
    else:
        print(f"Lane {args.id}: {state}")
    return 0


def fix_claims(receipt: dict, fix_id: str) -> tuple[list[str], list[str]]:
    """The fix lane's claims (#586): the repository files the review's findings name, never the landed lane's
    claims, which hold every path its check widened to and so overlap lanes started since. A named file another
    planned or active lane claims stays out, with a line saying so; tools/lane check widens the claims from the
    fix's own diff and warns if that touches another lane's claim (#574). Returns the claims and those lines."""
    claims, held, lines = [], [], []
    others = [r for r in occupying() if r["id"] != fix_id]
    for finding in receipt.get("findings", []):
        path = posixpath.normpath(finding.get("file") or ".")
        if path in (".", "..") or path.startswith(("/", "../")) or path in claims or path in held:
            continue
        holders = [(other, claim) for other in others for claim in other["claims"] if claims_overlap(path, claim)]
        if holders:
            held.append(path)
            lines.append(f"{path} stays out of the fix lane's claims: "
                         + ", ".join(f"lane {o['id']} (#{o['ticket']}) claims {c}" for o, c in holders)
                         + "; tools/lane check warns if the fix changes it")
        else:
            claims.append(path)
    return claims, lines


def hand_over(args) -> int:
    """The fix round: a follow-up lane <id>-review-fixes takes over the landed lane's worktree, where the resumed
    agent keeps its context (a resumed agent is fenced to its own worktree); its land is the fix and gets no
    review of its own."""
    record = load(args.id)
    receipt = read_json(receipt_path(args.id, "review"))
    if not receipt or receipt.get("status") != "finished" or not receipt.get("findings"):
        raise LaneError(f"hand-over refused: lane {args.id} has no finished review with findings")
    if record["status"] not in ("landed", "released") or not record.get("worktree") or not os.path.isdir(
            record["worktree"]):
        raise LaneError(f"hand-over refused: lane {args.id} is {record['status']} and has no worktree to hand over")
    fix_id = f"{args.id}-review-fixes"
    main = main_checkout(record["common_dir"])
    claims, held = fix_claims(receipt, fix_id)
    fix, rules = prepare(main, fix_id, record["ticket"], claims, record["base"], [])
    fix.update(review_fix_of=args.id, worktree=record["worktree"])
    register(fix, rules, args.force_reason, False)
    for line in held:
        print(f"lane: {line}")
    with locked("state"):
        record = load(args.id)
        record.update(worktree=None, handed_over={"to": fix_id, "worktree": fix["worktree"], "at": now()})
        save(record)
    with locked(f"review-{args.id}"):
        receipt = read_json(receipt_path(args.id, "review"))
        receipt["fix_lane"] = fix_id
        write_json(receipt_path(args.id, "review"), receipt)
    ledger(f"review-hand-over {args.id} to {fix_id} worktree={fix['worktree']}")
    print(f"The fix round runs in {fix['worktree']}: git checkout -B {fix['branch']} {fix['base']}, fix each finding "
          f"that holds, commit, then tools/lane check {fix_id} and report. Its land needs no review. Then mark "
          f"{args.id}'s findings: " + MARK_HELP.format(id=args.id).replace("<merge>", fix_id + "|<merge>"))
    return 0


def ship_review_label(sha: str) -> str:
    return f"ship-{sha[:12]}"


def start_overall_review(cwd: str, sha: str, base: str) -> str:
    """After promote --ship: the one overall review of base..sha in the background; it never holds the ship."""
    label = ship_review_label(sha)
    current = read_json(receipt_path(label, "review")) or {}
    if current.get("status") == "finished":
        return (f"overall review of {sha[:10]} already ran: " + ticket_state(retry_ticket(label, common_dir(cwd)))
                + f"; tools/lane review --overall {sha[:10]} prints it")
    if current.get("status") == "running" and alive(current.get("pid")):
        return f"overall review of {sha[:10]} is running (pid {current['pid']}, log {current.get('log')})"
    # A failed or killed review keeps its base: after the push, origin/main is the SHA itself.
    base = current.get("base") or base
    if git_ok(cwd, "merge-base", "--is-ancestor", sha, base):
        return f"no overall review: {base[:10]} already holds {sha[:10]}"
    argv = ["--overall", sha, "--since", base]
    if review_start_manual():
        return (f"overall review not started (STRAYLIGHT_LANE_REVIEW_START=manual): run tools/lane review "
                f"{' '.join(argv)}")
    receipt = spawn_review(label, {"kind": "overall", "sha": sha, "base": base}, argv, cwd)
    return (f"overall review of {base[:10]}..{sha[:10]} started in the background (pid {receipt['pid']}, log "
            f"{receipt['log']}); its findings become one ticket")


def file_ticket(receipt: dict, common: str) -> None:
    """The overall review's findings as one issue, a checklist, for the #347 queue (owner decision on #570)."""
    findings = receipt.get("findings", [])
    if not findings or receipt.get("issue"):
        return
    items = []
    for f in findings:
        where = (f" `{f['file']}:{f['line']}`" if f.get("file") and f.get("line")
                 else f" `{f['file']}`" if f.get("file") else "")
        items.append(f"- [ ] **{f['severity']}**{where} {f['title']}")
        items += [f"  {line}" for line in f.get("detail", "").splitlines() if line.strip()]
    body = (f"Found by the overall review before main (`tools/lane promote --ship`) of "
            f"{receipt['base'][:10]}..{receipt['tip'][:10]}, by {receipt.get('model')} at {receipt.get('effort')} "
            f"effort. For the #347 queue: split what holds into tickets there, and tick each item once it is fixed or "
            f"rejected.\n\n" + "\n".join(items) + "\n")
    created = subprocess.run([gh_command(), "issue", "create", *repo_args(common), "--title",
                              f"Overall review of {receipt['tip'][:10]}: {len(findings)} findings", "--body", body],
                             capture_output=True, text=True)
    if created.returncode == 0 and created.stdout.strip():
        receipt["issue"] = created.stdout.strip().splitlines()[-1]
        receipt.pop("issue_error", None)
    else:
        receipt["issue_error"] = ((created.stderr or created.stdout).strip() or f"gh exit {created.returncode}")[:300]
    ledger(f"review-ticket {receipt['label']} " + (f"filed {receipt['issue']}" if receipt.get("issue")
                                                    else f"failed: {receipt['issue_error']}"))


def retry_ticket(label: str, common: str) -> dict:
    """File the ticket of a finished overall review whose filing failed, without reviewing again."""
    with locked(f"review-{label}"):
        receipt = read_json(receipt_path(label, "review"))
        if receipt.get("findings") and not receipt.get("issue"):
            file_ticket(receipt, common)
            write_json(receipt_path(label, "review"), receipt)
    return receipt


def ticket_state(receipt: dict) -> str:
    if not receipt.get("findings"):
        return "no findings"
    return (f"ticket {receipt['issue']}" if receipt.get("issue")
            else f"the ticket is not filed ({receipt.get('issue_error')})")


def overall_review(args) -> int:
    cwd = os.getcwd()
    common = common_dir(cwd)
    sha = git(cwd, "rev-parse", "--verify", args.overall + "^{commit}")
    label = ship_review_label(sha)
    current = read_json(receipt_path(label, "review")) or {}
    status, pid = current.get("status"), current.get("pid")
    if status == "finished" and not args.force_reason:
        receipt = retry_ticket(label, common)
        print("\n".join(review_lines(receipt)))
        return 1 if receipt.get("issue_error") else 0
    if status == "running" and alive(pid) and pid != os.getpid() and not args.force_reason:
        print("\n".join(review_lines(current)))
        return 0
    # A rerun of a failed or killed review keeps its base.
    since = args.since or current.get("base")
    if not since:
        raise LaneError("give --since <base>: the overall review covers <base>..<sha> (promote --ship gives origin/main)")
    base = git(cwd, "merge-base", git(cwd, "rev-parse", "--verify", since + "^{commit}"), sha)
    subject = (f"The overall review before main (tools/lane promote --ship): every change from {base[:10]} to "
               f"{sha[:10]}, many lanes at once. Look for seams between them as well as bugs in each.")
    receipt = perform_review(label, {"kind": "overall", "sha": sha}, main_checkout(common), base, sha, subject,
                             finalize=lambda finished: file_ticket(finished, common))
    print("\n".join(review_lines(receipt)))
    return 0 if receipt["status"] == "finished" and not receipt.get("issue_error") else 1


def review(args) -> int:
    if args.overall:
        return overall_review(args)
    if not args.id:
        raise LaneError("give a lane id, or --overall <sha> --since <base>")
    if args.mark:
        return mark_review(args)
    if args.fix_lane:
        return hand_over(args)
    return review_lane(args)


def review_refusals(cwd, common: str, sha: str) -> list[str]:
    """The lanes landed since dev and in the SHA whose review is missing, unfinished or has an unmarked finding."""
    dev = git(cwd, "rev-parse", "--verify", "--quiet", "refs/heads/dev^{commit}", check=False)
    refusals = []
    for record in lanes():
        merge = (record.get("landed") or {}).get("merge")
        if not merge or record.get("common_dir") != common:
            continue
        if not git_ok(cwd, "merge-base", "--is-ancestor", merge, sha):
            continue
        if dev and git_ok(cwd, "merge-base", "--is-ancestor", merge, dev):
            continue
        complete, state = review_state(record["id"])
        if not complete:
            refusals.append(f"lane {record['id']} (#{record['ticket']}): {state}")
            continue
        # A finding marked fixed is fixed in what moves only when its follow-up merge is in the SHA.
        for finding in (read_json(receipt_path(record["id"], "review")) or {}).get("findings", []):
            mark = finding.get("mark") or {}
            if mark.get("kind") == "fixed" and not git_ok(cwd, "merge-base", "--is-ancestor", mark["merge"], sha):
                refusals.append(f"lane {record['id']} (#{record['ticket']}): finding #{finding['n']} is marked fixed "
                                f"by {mark['merge'][:10]}, which is not in {sha[:10]}")
    return refusals


def ticket_commented(record: dict) -> str | None:
    """None when the ticket has a comment since the lane started, else the refusal."""
    argv = [gh_command(), "issue", "view", record["ticket"], "--json", "comments", *repo_args(record["common_dir"])]
    result = subprocess.run(argv, capture_output=True, text=True)
    if result.returncode:
        return f"gh could not read #{record['ticket']}: {result.stderr.strip()}"
    since = parse_time(record["created"])
    comments = json.loads(result.stdout).get("comments", [])
    if any(parse_time(c["createdAt"]) >= since for c in comments):
        return None
    return (f"#{record['ticket']} has no comment since the lane started; post the lane's RED->GREEN evidence with "
            f"gh issue comment {record['ticket']}")


def size(path: str) -> int:
    result = subprocess.run(["du", "-sk", path], capture_output=True, text=True)
    return int(result.stdout.split()[0]) * 1024 if result.returncode == 0 and result.stdout else 0


def remove_tree(path: str, protected: list[str]) -> int:
    path = os.path.realpath(path)
    if not os.path.exists(path):
        return 0
    if any(path == p or p.startswith(path + "/") for p in ["/", *protected]):
        raise LaneError(f"refusing to remove {path}: it holds {', '.join(protected)}")
    freed = size(path)
    shutil.rmtree(path)
    return freed


def shared_partitions(*checkouts: str) -> list[Path]:
    """Cargo cache partitions (tools/cargo_build_cache.py) whose dependency files name a path under the checkouts."""
    found = []
    for partition in (cache_root() / "cargo-v2").glob("[0-9a-f]" * 64):
        if not partition.is_dir() or partition.is_symlink():
            continue
        for depfile in [*partition.glob("debug/*.d"), *partition.glob("release/*.d")]:
            try:
                with open(depfile, errors="replace") as handle:
                    text = handle.read(1 << 16)
                    if any(checkout + "/" in text for checkout in checkouts):
                        found.append(partition)
                        break
            except OSError:
                pass
    return found


def done(args) -> int:
    finish(args.id, args.force_reason)
    return 0


def finish_landed(lane_id: str, keep: bool) -> None:
    """After a green post-merge smoke: finish the lane as tools/lane done does. When its agent still locks the
    worktree, keep the worktree and release the lane; done finishes it later. A landed lane holds no slot, so a
    refused done only leaves cleanup behind."""
    if keep:
        print(f"Lane {lane_id} kept (--keep): it holds no slot; finish it with tools/lane done {lane_id}")
        return
    record = load(lane_id)
    if record["status"] == "done":
        # land and the lane's review both finish a reviewed lane; whichever comes second has nothing left to do.
        return
    worktree = record.get("worktree")
    lock = worktree_lock(main_checkout(record["common_dir"]), worktree) if worktree and os.path.isdir(worktree) else None
    if lock is not None:
        with locked("state"):
            record = load(lane_id)
            record.update(status="released", released=now())
            save(record)
            ledger(f"release {lane_id}: worktree {worktree} is locked ({lock}); slot and claims freed")
        print(f"Lane {lane_id} released: its slot and claims are free. Its agent still holds {worktree} "
              f"(locked: {lock}); once the agent exits, remove it with tools/lane done {lane_id}")
        return
    try:
        finish(lane_id, None)
    except LaneError as error:
        ledger(f"auto-done {lane_id} refused: {str(error).replace(chr(10), ' ')}")
        print(f"tools/lane done {lane_id} did not run after landing; the lane stays landed and holds no slot.\n"
              f"{error}\nFix that, then run tools/lane done {lane_id}")


def finish(lane_id: str, force_reason: str | None) -> None:
    with locked("state"):
        record = load(lane_id)
        refusals = []
        if record["status"] == "done":
            raise LaneError(f"lane {lane_id} is already done")
        if record["status"] not in ("landed", "released"):
            refusals.append(f"lane {lane_id} is {record['status']}, not landed")
        elif record.get("post_merge", {}).get("status") == "red":
            refusals.append("its post-merge check is red: fix forward (a follow-up commit on the lane) first")
        elif read_json(receipt_path(lane_id, "review")) is not None and not review_state(lane_id)[0]:
            # The fix round of the review runs in this worktree (#570); a lane landed without a review has none.
            refusals.append(f"its {review_state(lane_id)[1]}: mark each finding with " + MARK_HELP.format(id=lane_id))
        main = main_checkout(record["common_dir"])
        worktree = record.get("worktree")
        tip = git(main, "rev-parse", "--verify", "--quiet", record["branch"], check=False)
        integration = (record.get("landed") or {}).get("integration") or record.get("integration")
        if (tip and record["status"] in ("landed", "released")
                and not git_ok(integration, "merge-base", "--is-ancestor", tip, "HEAD")):
            refusals.append(f"{record['branch']} has commits that are not in {integration}")
        lock, leftover = None, []
        if worktree and os.path.isdir(worktree):
            if dirty(worktree):
                refusals.append(f"{worktree} has uncommitted changes")
            lock = worktree_lock(main, worktree)
            if lock is not None:
                refusals.append(f"an agent still holds {worktree} (locked: {lock}); run tools/lane done {lane_id} "
                                "once it exits")
            # #661: what the lane left running there stops first; a session, a terminal or a lease holds it.
            leftover, held = process_scan().sort_for_removal(worktree)
            refusals += [f"{reason}; it works in {worktree}" for reason in held]
        if record["ticket"] != "none" and not refusals:
            missing = ticket_commented(record)
            if missing:
                refusals.append(missing)
        if refusals and not force_reason:
            raise LaneError("done refused (not landed or not safe to remove):\n- " + "\n- ".join(refusals))
        if refusals:
            ledger(f"override done {lane_id}: {force_reason} ({'; '.join(refusals)})")
        freed, removed = 0, []
        if leftover:
            survivors = {p.pid for p in process_scan().stop(leftover)}
            for process in leftover:
                what = "did not stop" if process.pid in survivors else "stopped"
                ledger(f"done {lane_id}: {what} {process.describe()} in {worktree}")
                removed.append(f"{what} {process.describe()}")
        if worktree and os.path.isdir(worktree):
            freed += size(worktree)
            # A second --force removes a locked worktree, which only an override reaches.
            git(main, "worktree", "remove", "--force", *(["--force"] if lock is not None else []), worktree)
            removed.append(worktree)
        git(main, "worktree", "prune")
        harness = f"worktree-{os.path.basename(worktree)}" if worktree else None
        for branch in (record["branch"], harness):
            if not branch or not git_ok(main, "rev-parse", "--verify", "--quiet", "refs/heads/" + branch):
                continue
            if branch == harness and integration and not git_ok(main, "merge-base", "--is-ancestor", branch,
                                                                 git(integration, "rev-parse", "HEAD")):
                continue
            git(main, "branch", "-D", branch)
            removed.append(f"branch {branch}")
        protected = [main, str(Path.home()), str(state_dir().resolve())]
        for path in [*record.get("cargo_targets", []), *record.get("scratch", [])]:
            if os.path.exists(path):
                freed += remove_tree(path, protected)
                removed.append(path)
        # The lane's worktree, and the base checkouts a red check classified in, under its scratch (#568).
        checkouts = [path for path in (worktree, *record.get("scratch", [])[:1]) if path]
        for partition in shared_partitions(*checkouts) if checkouts else []:
            with open(str(partition) + ".lock", "a") as handle:
                try:
                    fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
                except BlockingIOError:
                    continue
                freed += remove_tree(str(partition), protected)
                removed.append(str(partition))
        record.update(status="done", done=now(), freed_bytes=freed)
        save(record)
        ledger(f"done {lane_id} freed={freed // 2**20} MiB removed={' '.join(removed) or '-'}")
    print(f"Lane {lane_id} done: claims released, {freed / 1e9:.1f} GB freed")
    for item in removed:
        print(f"  {item}" if item.startswith(("stopped ", "did not stop ")) else f"  removed {item}")


def receipt_state(record: dict) -> str:
    receipt = read_json(receipt_path(record["id"]))
    if not receipt:
        return "no receipt"
    text = receipt.get("status", "?")
    if record["status"] == "active":
        tip = git(main_checkout(record["common_dir"]), "rev-parse", "--verify", "--quiet",
                  record["branch"] + "^{tree}", check=False)
        if tip and tip != receipt.get("tree"):
            text += " (stale)"
    if record.get("post_merge"):
        text += f", post-merge {record['post_merge']['status']}"
    if record.get("landed") and record["status"] != "done":
        text += f", {review_state(record['id'])[1]}"
    return text


def list_lanes(args) -> int:
    shown = [r for r in lanes() if args.all or r["status"] != "done"]
    if args.json:
        # Scripts read lanes here (#577): every record with its worktree (null until adopt) and receipt state.
        print(json.dumps({"lanes": [dict(r, receipt=receipt_state(r)) for r in shown], "active": len(occupying()),
                          "cap": MAX_LANES, "cap_source": CAP_SOURCE, "host": host()}, indent=2))
        return 0
    for record in shown:
        print(f"{record['id']}  {record['status']}  #{record['ticket']}  {record['branch']}  receipt: {receipt_state(record)}")
        print(f"    claims: {' '.join(record['claims'])}" + (f"  after: {', '.join(record['after'])}" if record["after"] else ""))
        if record.get("worktree"):
            print(f"    worktree: {record['worktree']}")
    print(f"{len(occupying())} of {MAX_LANES} lanes active (cap {CAP_SOURCE}); {host_line(host())}")
    # #666: the repository it runs in, as last fetched; outside a Git checkout there is nothing to compare.
    if git_ok(os.getcwd(), "rev-parse", "--git-dir"):
        for line in ahead_lines(os.getcwd()):
            print(line)
    return 0


def main(argv=None) -> int:
    parser = argparse.ArgumentParser(prog="tools/lane", description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    commands = parser.add_subparsers(dest="command", required=True)
    p = commands.add_parser("start", help="register a lane: caps, claims, header for the Agent prompt")
    p.add_argument("id")
    p.add_argument("--ticket", required=True, help="issue number, or none")
    p.add_argument("--claims", nargs="+", required=True, metavar="GLOB")
    p.add_argument("--base", help="integration branch or commit (default: this worktree's branch)")
    p.add_argument("--branch", help="lane branch (default: lane/<id>)")
    p.add_argument("--after", nargs="+", default=[], metavar="ID", help="land after these lanes; their claims may overlap")
    p.add_argument("--scratch", nargs="+", default=[], metavar="DIR", help="extra scratch dirs done removes")
    p.add_argument("--create", action="store_true", help="create the worktree now instead of adopting one")
    p.add_argument("--force-reason", help="start despite the lane cap, disk or load; logged")
    p.set_defaults(run=start)
    p = commands.add_parser("next", help="the first ready entry of the queue: its brief header; --start registers it")
    p.add_argument("--start", action="store_true", help="register the lane, as lane start would")
    p.add_argument("--base", help="integration branch (default: the queue's base, else this worktree's branch)")
    p.add_argument("--create", action="store_true", help="with --start: create the worktree now")
    p.add_argument("--force-reason", help="with --start: start despite the lane cap, disk or load; logged")
    p.set_defaults(run=next_lane)
    p = commands.add_parser("adopt", help="register the worktree an Agent created")
    p.add_argument("id")
    p.add_argument("worktree")
    p.add_argument("branch")
    p.set_defaults(run=adopt)
    p = commands.add_parser("check", help="run the lane's affected checks and write its receipt")
    p.add_argument("id")
    p.add_argument("--rerun", action="store_true", help="run every suite even if a receipt covers the tree")
    p.add_argument("--slots", type=int, choices=range(1, 5),
                   help="verification slots, as verify --jobs (default: slotfather advise, at most "
                        f"{CHECK_MAX_JOBS}); checks run side by side while the cores they declare fit the slots' (#642)")
    p.set_defaults(run=check)
    p = commands.add_parser("land", help="merge a lane with a current green receipt, run the smoke, then finish it")
    p.add_argument("id")
    p.add_argument("--into", help="integration worktree (default: the worktree on the lane's base branch)")
    p.add_argument("-m", "--message")
    p.add_argument("--slots", type=int, choices=range(1, 5),
                   help="verify --jobs for the post-merge run (default: slotfather advise --max 3, the free slots "
                        "less the cores of load without a lease)")
    p.add_argument("--keep", action="store_true",
                   help="leave the landed lane for tools/lane done (another lane needs its artifacts)")
    p.add_argument("--force-reason", help="land without a current green receipt; logged")
    p.add_argument("--wait", type=float, default=120, metavar="SECONDS", help="wait this long for the landing lock")
    p.set_defaults(run=land)
    p = commands.add_parser("promote", help="the batch gate on a SHA, then fast-forward local dev (and main) to it "
                                            "and push it")
    p.add_argument("sha")
    p.add_argument("--ship", action="store_true", help="also main: pushes <sha>:dev and <sha>:main together")
    p.add_argument("--no-push", action="store_true",
                   help="move the local branches only, and only to a SHA the remote already has (#666)")
    p.add_argument("--jobs", type=int, choices=range(1, 9), metavar="{1..8}",
                   help="verify --jobs for the batch gate (default: slotfather advise --max 2, shared slots less "
                        "the cores of load without a lease, sized after any load wait)")
    p.add_argument("--remote", default="origin")
    p.add_argument("--wait", type=float, default=120, metavar="SECONDS", help="wait this long for the landing lock")
    p.add_argument("--install", action="store_true",
                   help="then install on this Mac from the gate worktree and run check-installed --expect <sha>")
    p.add_argument("--deploy", metavar="HOST", help="with --install: then build the Link package (linux/amd64) and "
                                                    "deploy it to HOST, such as user@host.example")
    p.add_argument("--force-reason", help="move dev although a lane landed since dev lacks a finished, fully marked "
                                          "review; logged")
    p.set_defaults(run=promote)
    p = commands.add_parser("sync", help="fetch, then fast-forward local dev and main to the remote under the landing "
                                         "lock; --drop-local resets them to it, keeping a backup branch")
    p.add_argument("--drop-local", action="store_true",
                   help="reset local dev and main to the remote; the commits it lacks go to backup/<branch>-<date>")
    p.add_argument("--remote", default="origin")
    p.add_argument("--wait", type=float, default=120, metavar="SECONDS", help="wait this long for the landing lock")
    p.set_defaults(run=sync)
    p = commands.add_parser("perf", help="the perf suite (#579) on a SHA in the gate worktree, alone on the machine; "
                                         "moves nothing")
    p.add_argument("sha")
    p.add_argument("--remote", default="origin", help="whose main a red run bisects from (default: origin)")
    p.set_defaults(run=perf)
    p = commands.add_parser("review", help="the lane's one independent review (Sol, or Opus when Codex is low), its "
                                           "marks and its fix lane; --overall for promote --ship")
    p.add_argument("id", nargs="?")
    p.add_argument("--mark", nargs=2, action="append", metavar=("N", "fixed:MERGE|rejected:REASON"),
                   help="mark finding N fixed by a follow-up merge (or the fix lane's id) or rejected with a reason")
    p.add_argument("--fix-lane", action="store_true",
                   help="register <id>-review-fixes on the landed lane's worktree for the fix round")
    p.add_argument("--overall", metavar="SHA", help="the overall review of --since..SHA; its findings become one ticket")
    p.add_argument("--since", metavar="BASE", help="with --overall: the base, origin/main for promote --ship")
    p.add_argument("--force-reason", help="review again although the lane has a review, or register the fix lane "
                                          "over the lane cap; logged")
    p.set_defaults(run=review)
    p = commands.add_parser("done", help="remove a landed lane's worktree, branches, targets and scratch")
    p.add_argument("id")
    p.add_argument("--force-reason", help="clean up a lane that is not landed or lacks a ticket comment; logged")
    p.set_defaults(run=done)
    p = commands.add_parser("list", help="active lanes, claims, receipts, disk and load")
    p.add_argument("--all", action="store_true", help="include done lanes")
    p.add_argument("--json", action="store_true", help="the lane records with their worktree and receipt state, the "
                                                        "cap and the host, as JSON")
    p.set_defaults(run=list_lanes)
    args = parser.parse_args(argv)
    try:
        return args.run(args)
    except LaneError as error:
        print(f"lane: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
