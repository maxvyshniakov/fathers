#!/usr/bin/env python3
"""Lanefather's verify command for this repository (.lanefather.toml [checks] verify; fathers#116, fathers#235).

  tools/lane-check --changed --base B --plan --json   each changed package's checks (tools/checks.py plan)
  tools/lane-check [--checks IDS | --suites verify] [--keep-going] [--jobs N]
                                                      runs them (tools/verify.py lane): report.json, and the line
                                                      `Verification report: <path>` Lanefather reads

The plan selects by package; a run knows every check's id, whichever the plan named.
"""
from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parent))

import checks  # tools/checks.py
import verify  # tools/verify.py

arguments = sys.argv[1:]
if "--plan" in arguments:
    base = arguments[arguments.index("--base") + 1] if "--base" in arguments[:-1] else ""
    if not base or sorted(arguments) != sorted(["--changed", "--base", base, "--plan", "--json"]):
        sys.exit("lane-check: a plan takes --changed --base REF --plan --json")
    sys.exit(checks.main(["plan", base]))
catalog = [(f"verify:{checks.encode(check.name)}", checks.step(check)) for check in checks.CHECKS]
sys.exit(verify.lane(arguments, catalog, root=checks.ROOT, command=[sys.executable, str(Path(__file__).resolve())]))
