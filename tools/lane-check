#!/usr/bin/env python3
"""Lanefather's verify command for this repository (.lanefather.toml [checks] verify; fathers#116).

  tools/lane-check --changed --base B --plan --json   each changed package's checks (tools/checks.py plan)
  tools/lane-check --checks IDS | --suites S ...      runs them through Repo-Kit's lane adapter, .githooks/lane-check

Repo-Kit's adapter plans every configured check for any change; the plan here selects by package and names the same
check ids, and the run hands every argument to that adapter with all checks configured (FATHERS_CHECKS=all).
"""
import os
from pathlib import Path
import sys

TOOLS = Path(__file__).resolve().parent
sys.path.insert(0, str(TOOLS))

import checks  # noqa: E402  tools/checks.py

arguments = sys.argv[1:]
if "--plan" in arguments:
    base = arguments[arguments.index("--base") + 1] if "--base" in arguments[:-1] else ""
    if not base or sorted(arguments) != sorted(["--changed", "--base", base, "--plan", "--json"]):
        sys.exit("lane-check: a plan takes --changed --base REF --plan --json")
    sys.exit(checks.main(["plan", base]))
adapter = TOOLS.parent / ".githooks/lane-check"
os.execve(adapter, [str(adapter), *arguments], {**os.environ, "FATHERS_CHECKS": "all"})
