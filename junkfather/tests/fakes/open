#!/usr/bin/env python3
"""`open -g -a "Safari Technology Preview"`: starts the fake app's main process and exits at once."""
import os
import subprocess
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from _fake import begin, save  # noqa: E402

state, args = begin("open")
child = subprocess.Popen([state["stp_app"]], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
state = begin("open-done")[0]
state.setdefault("stp", []).append(child.pid)
save(state)
