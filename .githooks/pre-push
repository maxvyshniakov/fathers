#!/usr/bin/env python3
"""Git's pre-push hook: each pushed commit's own checks in a clean worktree (tools/prepush.py, fathers#235).

Skip once with `git push --no-verify`.
"""
from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "tools"))

import prepush  # tools/prepush.py of this checkout

sys.exit(prepush.main(sys.stdin.read(), sys.argv))
